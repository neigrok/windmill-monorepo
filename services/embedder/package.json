{
  "name": "@windmill/embedder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Journal echoes embedding sidecar — paraphrase-multilingual-MiniLM-L12-v2 q8, server-side only.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node check/server.mjs",
    "check:fixture": "node check/fixture.mjs",
    "check:browser": "node check/browser.mjs",
    "fixture:write": "node check/fixture.mjs --write"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
