function(wm_validate_sync_composition manifest registered)
  string(JSON count LENGTH "${manifest}" registries)
  if(count EQUAL 0)
    message(FATAL_ERROR "Sync composition needs at least one registry")
  endif()
  math(EXPR last "${count} - 1")
  set(selected)
  foreach(index RANGE 0 ${last})
    string(JSON filename GET "${manifest}" registries ${index})
    if(NOT filename MATCHES "^[a-z][a-z0-9-]*\\.registry\\.json$")
      message(FATAL_ERROR "Invalid sync registry filename: ${filename}")
    endif()
    if(filename IN_LIST selected)
      message(FATAL_ERROR "Sync composition repeats registry: ${filename}")
    endif()
    list(APPEND selected "${filename}")
  endforeach()
  set(unique_registered ${registered})
  list(REMOVE_DUPLICATES unique_registered)
  list(LENGTH registered registered_count)
  list(LENGTH unique_registered unique_count)
  if(NOT registered_count EQUAL unique_count)
    message(FATAL_ERROR "Sync product bindings repeat a registry")
  endif()
  list(SORT selected)
  list(SORT unique_registered)
  if(NOT "${selected}" STREQUAL "${unique_registered}")
    message(FATAL_ERROR "Sync composition registries must match the explicit server product bindings")
  endif()
endfunction()
