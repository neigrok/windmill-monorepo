# Local development environment for windmill_server. Copy to .env and adjust:
#
#   cp .env.example .env
#   set -a; source .env; set +a; ./build/windmill_server
#
# .env is gitignored — real keys never belong in the repo. Production values are injected by
# the deploy workflow into deploy/.env, which docker-compose reads; this file is only for
# running the binary directly on a dev machine.

# --- required ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost/windmill
PORT=8088

# The dev page's credentialed fetches fail CORS without this ("Failed to fetch").
WINDMILL_ALLOWED_ORIGINS=http://localhost:5173

# Where the built SPA lives. The server reads index.html from here for the /t/:id share pages
# and gallery.html for the /gallery wall — both degrade politely when it is unset, so a
# stale/absent dist shows up as a bare page rather than a crash. Run `npm run build` first.
WINDMILL_WEB_ROOT=../web/dist

# --- MCP --------------------------------------------------------------------------------
# WINDMILL_MCP_USER must be a real uuid in `users` (owner_id is a uuid, so "dev" 500s on
# create_tree). The value below is the seeded dev@localhost user in the local database.
WINDMILL_MCP_TOKEN=devtoken
WINDMILL_MCP_USER=ed416545-6c9f-45d1-bc46-0451c218a101

# --- optional: each feature stays dark without its key ------------------------------------
# Magic-link email. Unset ⇒ the send is REFUSED, not logged: ResendClient short-circuits before it
# builds a request and /v1/auth/magic-link answers 502. There is no token in the log to grep. To get
# a signed-in session locally, mint one straight into `sessions` — RUNNING.md §5 walks it.
# RESEND_API_KEY=
# RESEND_FROM=Windmill <onboarding@resend.dev>

# Paste-import LLM escalation (/v1/compose) and the tending agent. Unset ⇒ 503 compose-unavailable
# and a tending run that never starts.
# ANTHROPIC_API_KEY=

# Tending ships dark: the composer renders nothing until this is true AND a key is set above.
# TENDING_ENABLED=false

# --- weekly reminders -----------------------------------------------------------------------
# The engine sweeps every 15 minutes regardless; these gate only whether a mail actually leaves.
# A decision is recorded in reminder_week either way, so the ledger is honest while dark and you
# can read what WOULD have gone out.
#   REMINDERS_ENABLED   false ⇒ nothing is ever sent
#   REMINDERS_ALLOWLIST comma-separated user uuids. EMPTY MEANS NOBODY, which is the point —
#                       run the whole engine against your own account for a month first.
#                       Both gates together answer "can the engine reach THIS person": the
#                       settings section hides itself, and refuses to be switched on, for anyone
#                       they do not name. An account cannot ask for mail we will not send it.
#   REMINDERS_ADMIN_TOKEN  bearer for POST /v1/admin/reminders/sweep. Unset ⇒ the route 404s and
#                       never advertises itself. Required for a dry run or an as-of rehearsal.
# REMINDERS_ENABLED=false
# REMINDERS_ALLOWLIST=
# REMINDERS_ADMIN_TOKEN=
#   RESEND_WEBHOOK_SECRET  the whsec_… from Resend → Webhooks, for a receiver subscribed to
#                       email.bounced and email.complained at POST /v1/resend/webhook. One Resend
#                       account means one webhook for every mail Windmill sends, so a permanent
#                       bounce or a spam complaint stops EVERY stream to that mailbox at once —
#                       reminder_subscription.suppressed and journal_nudge.suppressed both — while
#                       a transient bounce stops none of them. Sign-in mail is never gated: the
#                       magic link is the way back for someone who fixes their address.
#                       ORDER MATTERS: set this secret and deploy FIRST, then register the endpoint
#                       in Resend. The other way round, every genuine delivery arrives at an
#                       unarmed verifier, is refused 401, and burns one of Svix's retries.
#                       Unset ⇒ the endpoint 401s every delivery, so it is dark, not forgeable
#                       (a run of refusals is logged as a warning so a dark door is findable).
#                       Locally you rarely want this — leave it unset and the door stays shut.
# RESEND_WEBHOOK_SECRET=

# --- journal: the nightly nudge, and the echo rehearsal door ---------------------------------
# The daily heartbeat sweeps regardless; these gate only whether a knock actually leaves. The knock
# TIME is the device's — the server stores a materialised instant and never derives a rhythm — so
# there is no timezone here to get wrong.
#   JOURNAL_NUDGE_ENABLED   false ⇒ nothing is ever sent
#   JOURNAL_NUDGE_ALLOWLIST comma-separated user uuids, upper or lower case. EMPTY MEANS NOBODY,
#                       the same stance REMINDERS_ALLOWLIST takes above and for a sharper reason:
#                       journal HIDES its nudge settings panel from anyone this gate refuses, so
#                       naming an id is what makes the feature exist for that account at all, not
#                       merely what lets its mail out. Because empty reaches no one, the flag and
#                       the list can be set in either order and neither alone launches anything —
#                       which is the point, since mail is the one mistake you cannot walk back.
#                       Run it against your own account first, the way reminders were run.
#   JOURNAL_NUDGE_ADMIN_TOKEN  bearer for POST /v1/admin/journal/nudge/sweep. Unset ⇒ the route
#                       403s and never advertises itself. Required for a dry run or an as-of
#                       rehearsal (test/e2e/journal_nudge.sh drives exactly this door).
# JOURNAL_NUDGE_ENABLED=false
# JOURNAL_NUDGE_ALLOWLIST=
# JOURNAL_NUDGE_ADMIN_TOKEN=
#   JOURNAL_ECHO_ADMIN_TOKEN  the echoes twin: bearer for POST /v1/admin/journal/echo/sweep, the
#                       operator's rehearsal of one nightly derivation pass. Unset ⇒ 403, its
#                       resting state. The pass itself is armed by neither this nor a flag — it
#                       needs an embedder (JOURNAL_EMBEDDER_URL) and ANTHROPIC_API_KEY, and with
#                       either unwired the whole sweep is a quiet no-op that writes nothing.
# JOURNAL_ECHO_ADMIN_TOKEN=

# Google sign-in, billing, and telemetry sinks — all no-ops when unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PADDLE_API_KEY=
# PADDLE_ENV=sandbox
# PADDLE_PRICE_ID=
# PADDLE_WEBHOOK_SECRET=
# SENTRY_DSN=
# Uncaught exceptions AND every LOG_* line go to the project above. Unset ⇒ both are no-ops.
# SENTRY_ENVIRONMENT defaults to "production" — set it to anything else when running with a real DSN
# on a laptop, or local noise lands in the environment you page on.
# SENTRY_LOG_LEVEL is the volume knob: trace|debug|info|warn|error|fatal, default info. It only
# filters what is FORWARDED; stdout keeps every line either way.
# SENTRY_ENVIRONMENT=local
# SENTRY_LOG_LEVEL=info
# SENTRY_RELEASE=
# AMPLITUDE_API_KEY=
