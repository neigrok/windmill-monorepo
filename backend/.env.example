# Local development environment for windmill_server. Copy to .env and adjust:
#
#   cp .env.example .env
#   set -a; source .env; set +a; ./build/windmill_server
#
# .env is gitignored — real keys never belong in the repo. Production values are injected by
# the deploy workflow into deploy/.env, which docker-compose reads; this file is only for
# running the binary directly on a dev machine.

# --- required ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost/windmill
PORT=8088

# The dev page's credentialed fetches fail CORS without this ("Failed to fetch").
WINDMILL_ALLOWED_ORIGINS=http://localhost:5173

# Where the built SPA lives. The server reads index.html from here for the /t/:id share pages
# and gallery.html for the /gallery wall — both degrade politely when it is unset, so a
# stale/absent dist shows up as a bare page rather than a crash. Run `npm run build` first.
WINDMILL_WEB_ROOT=../windmill-frontend/dist

# --- MCP --------------------------------------------------------------------------------
# WINDMILL_MCP_USER must be a real uuid in `users` (owner_id is a uuid, so "dev" 500s on
# create_tree). The value below is the seeded dev@localhost user in the local database.
WINDMILL_MCP_TOKEN=devtoken
WINDMILL_MCP_USER=ed416545-6c9f-45d1-bc46-0451c218a101

# --- optional: each feature stays dark without its key ------------------------------------
# Magic-link email. Unset ⇒ links are logged to stdout instead of sent, which is what you want
# locally — grep the server log for the token and visit /#/auth?token=<token>.
# RESEND_API_KEY=
# RESEND_FROM=Windmill <onboarding@resend.dev>

# Paste-import LLM escalation (/v1/compose) and the tending agent. Unset ⇒ 503 compose-unavailable
# and a tending run that never starts.
# ANTHROPIC_API_KEY=

# Tending ships dark: the composer renders nothing until this is true AND a key is set above.
# TENDING_ENABLED=false

# --- weekly reminders -----------------------------------------------------------------------
# The engine sweeps every 15 minutes regardless; these gate only whether a mail actually leaves.
# A decision is recorded in reminder_week either way, so the ledger is honest while dark and you
# can read what WOULD have gone out.
#   REMINDERS_ENABLED   false ⇒ nothing is ever sent
#   REMINDERS_ALLOWLIST comma-separated user uuids. EMPTY MEANS NOBODY, which is the point —
#                       run the whole engine against your own account for a month first.
#                       Both gates together answer "can the engine reach THIS person": the
#                       settings section hides itself, and refuses to be switched on, for anyone
#                       they do not name. An account cannot ask for mail we will not send it.
#   REMINDERS_ADMIN_TOKEN  bearer for POST /v1/admin/reminders/sweep. Unset ⇒ the route 404s and
#                       never advertises itself. Required for a dry run or an as-of rehearsal.
# REMINDERS_ENABLED=false
# REMINDERS_ALLOWLIST=
# REMINDERS_ADMIN_TOKEN=

# Google sign-in, billing, and telemetry sinks — all no-ops when unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PADDLE_API_KEY=
# PADDLE_ENV=sandbox
# PADDLE_PRICE_ID=
# PADDLE_WEBHOOK_SECRET=
# SENTRY_DSN=
# Uncaught exceptions AND every LOG_* line go to the project above. Unset ⇒ both are no-ops.
# SENTRY_ENVIRONMENT defaults to "production" — set it to anything else when running with a real DSN
# on a laptop, or local noise lands in the environment you page on.
# SENTRY_LOG_LEVEL is the volume knob: trace|debug|info|warn|error|fatal, default info. It only
# filters what is FORWARDED; stdout keeps every line either way.
# SENTRY_ENVIRONMENT=local
# SENTRY_LOG_LEVEL=info
# SENTRY_RELEASE=
# AMPLITUDE_API_KEY=
