# The deploy workflow renders ~/windmill/.env on the VPS from GitHub secrets & variables.
# This file documents every key it writes. To run the stack by hand on the VPS, copy it
# to .env and fill in real values.

# Image tag to run. CI sets this to the commit SHA; `latest` for a manual pull.
IMAGE_TAG=latest

# Postgres superuser password (GitHub secret POSTGRES_PASSWORD). The DATABASE_URL the
# services use is derived from it inside docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Public hostnames (GitHub variables). DNS A records must point at this VPS. DOMAIN_APP is the
# single origin: Caddy serves the SPA there and path-routes /v1, /mcp and /oauth to the server.
DOMAIN_APP=example.com
# Transitional alias for the old separate API host, still proxied to the server so a
# not-yet-rebuilt frontend keeps working. Retire once nothing references it.
DOMAIN_API=api.example.com

# Let's Encrypt registration address (GitHub variable ACME_EMAIL).
ACME_EMAIL=you@example.com

# Comma-separated Origins the MCP HTTP endpoint accepts; empty = allow all.
WINDMILL_MCP_ALLOWED_ORIGINS=

# Resend transactional email API key (GitHub secret RESEND_API_KEY) — auth emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The magic-link sender (GitHub variable RESEND_FROM). REQUIRED, and guarded by the deploy: it must be
# an address on a domain verified in Resend. Resend's shared test sender (onboarding@resend.dev) is not
# a fallback for a real deployment — Resend accepts it only for the account owner and answers 422 for
# everyone else, so sign-up would work for whoever is testing and for no one else.
RESEND_FROM=Windmill <sign-in@example.com>

# Journal voice (Talk) — OpenAI gpt-4o-transcribe. Empty ⇒ the transcribe route answers 503 and the
# client hides Talk; set it to arm voice for Windmill One subscribers. Optional.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# WINDMILL_APP_URL and WINDMILL_COOKIE_DOMAIN are derived from DOMAIN_APP in docker-compose;
# override them here only for a split-domain setup. The app's own origin is always trusted
# for credentialed CORS; add any extra origins (comma-separated) here.
WINDMILL_ALLOWED_ORIGINS=

# Shared bearer token that gates the public MCP endpoint (GitHub secret WINDMILL_MCP_TOKEN).
# Agents send `Authorization: Bearer <token>`; empty leaves /mcp unauthenticated. Pick a
# long random value (e.g. `openssl rand -hex 32`).
WINDMILL_MCP_TOKEN=
