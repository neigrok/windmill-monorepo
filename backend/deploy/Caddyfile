# Automatic HTTPS via Let's Encrypt. Caddy proxies WebSockets transparently, so the collab
# socket needs no extra config. Single origin: the app and its own backend share $DOMAIN_APP —
# the SPA is served statically and /v1, /mcp, /oauth and the OAuth well-knowns are path-routed
# to windmill_server (REST + collab socket + MCP, one process). $DOMAIN_API is kept as a
# transitional alias while the deployed frontend build is flipped to same-origin; retire it
# once nothing points at it.
{
	email {$ACME_EMAIL}
}

# Refuse origin traffic that didn't arrive through Cloudflare, so the rate limiter's trust in
# CF-Connecting-IP can't be forged by hitting the VPS directly.
#
# IMPORT THIS FIRST IN EVERY SITE BLOCK, AND KEEP IT A `handle`. Until 2026-08-22 the check was a
# bare `respond @not_cloudflare 403`, and a bare respond is placed by Caddy's fixed directive order
# — which put it AFTER the terminal `handle @backend { reverse_proxy }` and `handle { file_server }`
# below. Every request was therefore answered before the IP check ran and the 403 never once fired:
# the gate was dead code for its whole life (2026-08-16 security audit, INFRA-1). `handle` blocks
# are mutually exclusive and evaluated in the order they appear in the source, so the block that
# imports first is the one that terminates ahead of routing. `caddy adapt` is how you check: on both
# hosts the 403 subroute must come before the `reverse_proxy` and `file_server` subroutes. It is not
# index [0] — [0] is the `header` directive, which is non-terminal and matches everything — so read
# the order, not the number, or you will conclude a working gate is broken.
#
# CF_IPS is Cloudflare's published edge list, fetched from api.cloudflare.com by the deploy workflow
# (.github/workflows/deploy.yml) and injected as an env var. docker-compose.yml carries the same
# list as its committed default, so an unset variable fails CLOSED onto the real edge ranges rather
# than open to the internet. What it must never be is EMPTY: Caddy starts happily on an empty
# remote_ip matcher and then 403s EVERY request, from Cloudflare included (measured) — a total
# outage. Both the fetch and the compose default are guarded so an empty value cannot get here.
#
# The ACME challenge path is carved out on purpose. Certificates are what keeps this site
# reachable at all, and an HTTP-01 challenge is answered by Let's Encrypt reaching the origin —
# through Cloudflare while a host is proxied, but DIRECTLY the moment one is set to DNS-only, or
# during any window where the proxy is off. A 403 there does not fail loudly; it fails in sixty
# days, when the certificate expires. On the app host the path carries no data and no session — it
# serves a token Caddy itself just minted, and anything else under it falls to the file server,
# which has no such directory and 404s. On the API host, whose only terminal block is the proxy, an
# exempted request does reach windmill_server, where drogon has no route under that prefix and 404s
# it; nothing behind it is reachable, and a traversal cannot escape the carve-out because Caddy
# cleans the path before matching (`/.well-known/acme-challenge/../../v1/me` is refused, measured).
# Caddy's path matcher is case-insensitive, so the exemption is wider than it reads — `/.WELL-KNOWN/…`
# passes the gate too, and lands on the same 404. Both are stated because a carve-out in a security
# gate should say exactly how wide it is.
(cloudflare_only) {
	@not_cloudflare {
		not remote_ip {$CF_IPS}
		not path /.well-known/acme-challenge/*
	}
	handle @not_cloudflare {
		respond 403
	}
}

# The single origin: static SPA + same-origin backend (so there is no CORS between them). The
# frontend (windmill repo) is a Vite SPA rsync'd into ./web by its own deploy; everything under
# the backend paths is reverse-proxied to windmill_server on the same host.
{$DOMAIN_APP} {
	import cloudflare_only
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# The app's own backend: REST + /v1/socket (WebSocket), MCP, the OAuth authorization-server
	# endpoints, the OAuth discovery documents, the /t/:id share pages (served with per-tree
	# unfurl meta), the /gallery public wall (gallery.html with the card grid spliced in), and the
	# /og/:id.png unfurl cards the og:image tags point at. Hash-routed SPA otherwise (try_files is
	# a net). NOTE /gallery is exact, never /gallery* — the server reads the template off disk
	# (GalleryApi.cpp, readWebFile) and a wider matcher would send /gallery.html here too, where
	# nothing answers it. Its own 301 back to /gallery lives with the other aliases below.
	@backend path /v1/* /t/* /og/* /gallery /mcp /mcp/* /oauth/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/openid-configuration /.well-known/openid-configuration/*
	handle @backend {
		reverse_proxy server:8080
	}
	handle {
		encode gzip zstd
		root * /srv/windmill-web

		# The product landings moved from /products/<name> to /<name> (2026-08-01). 301 so old
		# links, bookmarks and search results follow; the static dirs moved with them. The /*
		# arms catch old deep links (/products/journal/index.html was live); {query} keeps UTM
		# params (Caddy emits a bare trailing ? when the query is empty — harmless). These live
		# INSIDE this handle, not beside it: `redir` is sorted ahead of `handle` by Caddy's
		# directive order, so at the site level they would answer a non-Cloudflare client with a
		# 301 before the origin gate above ever ran. Nothing routes /products/* to the backend,
		# so this is where they always effectively belonged.
		@oldRoadmap path /products/roadmap /products/roadmap/*
		redir @oldRoadmap /roadmap?{query} permanent
		@oldJournal path /products/journal /products/journal/*
		redir @oldJournal /journal?{query} permanent
		@oldGym path /products/gym /products/gym/*
		redir @oldGym /gym?{query} permanent

		# The extensionless twin of every shelf page. /pricing is what people type and paste, and
		# it used to answer 200 with the brand root — a second URL for a page that already has one.
		# 301 onto the .html each page's own canonical names, so links land where the canonical is.
		@shelfAlias path /pricing /privacy /terms /refunds /changelog /connect
		redir @shelfAlias {path}.html permanent

		# The gallery is the one page whose file name is not its URL: the wall is server-rendered at
		# /gallery (the backend splices the cards into this very file), and gallery.html canonicals
		# itself there. Serving the empty template at its own URL too is one page under two links.
		redir /gallery.html /gallery permanent

		# Two files' worth of caching policy, stated at the origin because guessing is worse.
		#
		# /sw.js must never be stale: a browser replaces a service worker only when it fetches bytes
		# that differ, so a stale copy keeps serving its old caching policy to a phone that already
		# has it. no-cache means revalidate, not don't-store; the etag makes that check a 304.
		#
		# /assets/* is the opposite: vite content-hashes every filename, so a given URL's bytes can
		# never change. A year, immutable, and the browser stops revalidating them entirely.
		#
		# NOTE (2026-08-02): these are correct and currently INERT. Cloudflare's Browser Cache TTL
		# is set to 4 hours in the dashboard and rewrites both — measured: /sw.js AND a hashed
		# /assets/*.js both come back max-age=14400 with cf-cache-status MISS, i.e. the override
		# happens on the way out, not from an edge hit. Flip that setting to "Respect Existing
		# Headers" and these two lines start doing their jobs; until then the origin at least states
		# the truth rather than leaving Cloudflare to invent it.
		@serviceWorker path /sw.js
		header @serviceWorker Cache-Control "no-cache"
		@hashedAssets path /assets/*
		header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
		# /app is the only pathname the SPA answers that is nothing on disk — App.jsx's ownRoute is
		# '/', '/app', '/app/*' and the product landings, and the landings ARE directories here
		# (scripts/build-landing-shells.mjs writes /roadmap/index.html and its two siblings). Naming
		# it is what lets try_files below end without a catch-all, and that is the point:
		#
		# until now try_files ended in /index.html, so EVERY unknown path answered 200 with the brand
		# root. /email/logo.png, /typo, /wp-admin — all of them a copy of the homepage, none of them
		# a 404. Google calls that a soft 404: it either indexes the copies or spends the crawl
		# budget deciding not to. An unknown path is now a real 404 wearing the page below.
		@appShell path /app /app/*
		rewrite @appShell /index.html

		try_files {path} {path}/index.html
		file_server
	}

	# The 404 the file server now raises, dressed as a page: public/404.html is the shelf chrome
	# with the whole house linked from it, and it is `noindex, follow` — it must not be indexed,
	# but the links out of it are exactly what a crawler that arrived on a dead URL should follow.
	# `status 404` keeps the code honest; serving that body with a 200 would be the soft 404 again.
	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			root * /srv/windmill-web
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# Transitional alias: the previous separate API hostname, still proxying to the same server so
# the currently-deployed frontend build keeps working until it is rebuilt same-origin. Retire
# once no client references it. (The old mcp.$DOMAIN subdomain is gone — MCP lives at /mcp now.)
{$DOMAIN_API} {
	import cloudflare_only
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# This host answers /gallery and /t/:id with real, indexable HTML — the same pages the app
		# host serves. Their canonicals name windmill.works (SharePageApi.cpp hardcodes the host),
		# so a crawler that found them here would fold them back anyway, but only after crawling a
		# whole second copy of the site. Say it at the door instead. Never index anything on the
		# transitional hostname; the app host is the site.
		X-Robots-Tag "noindex"
	}
	# A 404 on /robots.txt reads as "crawl everything" — and this host has no file server to answer
	# it, so it 404s. Answer it here, in the only words this hostname has for a crawler.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
			# The transitional API hostname. The site is https://windmill.works.
			User-agent: *
			Disallow: /
			ROBOTS 200
	}
	handle {
		reverse_proxy server:8080
	}
}
