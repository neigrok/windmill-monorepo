cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../../../../cmake/SyncComposition.cmake")

set(manifest "{\"composition\":\"three\",\"registries\":[\"beta.registry.json\",\"gamma.registry.json\",\"alpha.registry.json\"]}")
set(registered gamma.registry.json alpha.registry.json beta.registry.json)
if(DEFINED CASE)
  if(CASE STREQUAL "duplicate_manifest")
    set(manifest "{\"composition\":\"three\",\"registries\":[\"alpha.registry.json\",\"alpha.registry.json\"]}")
  elseif(CASE STREQUAL "duplicate_binding")
    list(APPEND registered alpha.registry.json)
  elseif(CASE STREQUAL "unbound_member")
    list(REMOVE_ITEM registered gamma.registry.json)
  elseif(CASE STREQUAL "unused_binding")
    list(APPEND registered delta.registry.json)
  endif()
  wm_validate_sync_composition("${manifest}" "${registered}")
  return()
endif()

wm_validate_sync_composition("${manifest}" "${registered}")
foreach(case duplicate_manifest duplicate_binding unbound_member unused_binding)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(result EQUAL 0 OR NOT error MATCHES "Sync composition|Sync product bindings")
    message(FATAL_ERROR "Expected ${case} to reject composition: ${result} ${output} ${error}")
  endif()
endforeach()
