# Keep the build context tiny and hermetic: host CMake caches carry absolute paths
# and a macOS/arm generator, and would poison the in-image Linux configure.
build/
cmake-build-*/
**/__pycache__/
**/*.py[cod]
# The build stage does `COPY . .`, so a developer's .env would be baked into that layer — the
# runtime stage copies only binaries, but the layer is still an image on their disk.
.env
.env.*
.git/
.github/
.idea/
.claude/
uploads/
# Only the image's migration tools and deployment test inputs enter the build.
deploy/*
!deploy/Caddyfile
!deploy/docker-compose.yml
!deploy/deploy-production.sh
!deploy/gym-migration/
deploy/gym-migration/*
!deploy/gym-migration/rehearse.py
!deploy/gym-migration/schema-compatibility.sh
!deploy/gym-migration/cutover-production.sh
*.md
!products/gym/ARCHITECTURE.md
!products/journal/ARCHITECTURE.md
