# Monorepo root ignores. Each surface keeps its own .gitignore under backend/, web/.

# The pre-restructure repos, kept as a local recovery net (also live on GitHub).
.attic/

# OS / editor cruft
.DS_Store
**/.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Personal, per-machine Claude settings (skills/ stay tracked)
.claude/settings.local.json

# Build outputs / dependencies (sub-.gitignores also cover these; belt and braces)
node_modules/
dist/
dist-ssr/
build/
cmake-build-*/
*.log

# Native build outputs
.build/
.swiftpm/
.gradle/
apps/android/local.properties

# Drogon's upload scratch tree. It is created eagerly at startup — 256 empty hex-named directories
# under uploads/tmp/ — whether or not the server ever accepts a file, and it lands wherever the
# binary was run from, which is usually the checkout.
uploads/

# Secrets — never commit
.env
*.local
build-*/
