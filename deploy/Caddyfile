# Automatic HTTPS via Let's Encrypt. Caddy proxies WebSockets transparently, so the
# collab socket on windmill_server needs no extra config. The API and MCP hostnames both
# proxy to windmill_server (MCP is mounted in-process); the app hostname is a static site.
#
# Single-host alternative (one domain, path-routed) — replace the two blocks below with:
#   {$DOMAIN_API} {
#       handle /mcp* { reverse_proxy mcp:8090 }
#       handle       { reverse_proxy server:8080 }
#   }

{
	email {$ACME_EMAIL}
}

# Refuse origin traffic that didn't arrive through Cloudflare, so the rate limiter's trust in
# CF-Connecting-IP can't be forged by hitting the VPS directly. CF_IPS is Cloudflare's current
# edge list, fetched from api.cloudflare.com at deploy time and injected as an env var (never
# hardcoded). It defaults to allow-all, so a failed fetch fails open rather than locking us out.
(cloudflare_only) {
	@not_cloudflare not remote_ip {$CF_IPS}
	respond @not_cloudflare 403
}

{$DOMAIN_API} {
	import cloudflare_only
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy server:8080
}

# MCP is now served in-process by windmill_server (one RoomRegistry for REST + socket + MCP),
# so this hostname proxies to the same upstream as the API. The token audience stays the MCP
# host (WINDMILL_MCP_PUBLIC_URL), so existing OAuth connections are unaffected.
{$DOMAIN_MCP} {
	import cloudflare_only
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy server:8080
}

# The frontend (windmill repo) is a static Vite SPA rsync'd into ./web by its own deploy
# workflow; Caddy serves it here. Hash-routed, so try_files is just a safety net.
{$DOMAIN_APP} {
	import cloudflare_only
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
	}
	encode gzip zstd
	root * /srv/windmill-web
	try_files {path} /index.html
	file_server
}
