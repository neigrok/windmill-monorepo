{
  "entities": [
    {
      "type": "journalState",
      "guarded": false,
      "held": false,
      "ordered": false,
      "removable": false
    },
    {
      "type": "page",
      "guarded": false,
      "held": false,
      "ordered": false,
      "removable": false
    }
  ],
  "rules": [
    {
      "kind": "server",
      "name": "journal.claim",
      "subject": "page",
      "codes": [
        "claim-conflict"
      ]
    },
    {
      "kind": "local",
      "name": "journal.claimPage.body",
      "subject": "journal",
      "spec": {
        "path": "journal.claimPage.body",
        "kind": "text",
        "unit": "bytes",
        "min": 0,
        "max": 131072,
        "trim": false,
        "nfc": false
      }
    },
    {
      "kind": "local",
      "name": "journal.claimPage.claimId",
      "subject": "journal",
      "spec": {
        "path": "journal.claimPage.claimId",
