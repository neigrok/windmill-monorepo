        "min": 1,
        "max": 128,
        "trim": false,
        "nfc": false
      }
    },
    {
      "kind": "local",
      "name": "journal.claimPage.source",
      "subject": "journal",
      "spec": {
        "path": "journal.claimPage.source",
        "kind": "choice",
        "values": [
          "typed",
          "spoken"
        ]
      }
    },
    {
      "kind": "local",
      "name": "journal.contentClock",
