[
  {"name": "a frame of silence has no energy", "input": {"op": "PauseRule.energy", "samples": [[0, 2400]]}, "expect": {"energy": 0}},
  {"name": "a full-scale frame has an energy of 1,073,741,824", "input": {"op": "PauseRule.energy", "samples": [[-32768, 2400]]}, "expect": {"energy": 1073741824}},
  {"name": "a sum of squares of 2,399 rounds down to nothing", "input": {"op": "PauseRule.energy", "samples": [[1, 2399], 0]}, "expect": {"energy": 0}},
  {"name": "a sum of squares of 2,400 is an energy of one", "input": {"op": "PauseRule.energy", "samples": [[1, 1200], [-1, 1200]]}, "expect": {"energy": 1}},
  {"name": "a frame of amplitude 103 stays under SPEECH_MIN", "input": {"op": "PauseRule.energy", "samples": [[103, 1200], [-103, 1200]]}, "expect": {"energy": 10609}},
  {"name": "a frame of amplitude 104 passes SPEECH_MIN", "input": {"op": "PauseRule.energy", "samples": [[104, 1200], [-104, 1200]]}, "expect": {"energy": 10816}},
  {"name": "an empty sequence sends nothing", "input": {"op": "PauseRule.commits", "energies": []}, "expect": {"commits": []}},
  {"name": "a sequence shorter than a block sends nothing", "input": {"op": "PauseRule.commits", "energies": [[1000000, 5]]}, "expect": {"commits": []}},
  {"name": "seven quiet frames after ten of speech send one commit", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 10], [0, 7]]}, "expect": {"commits": [27]}},
  {"name": "six quiet frames send nothing", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 10], [0, 6]]}, "expect": {"commits": []}},
  {"name": "nine speech frames and a pause send nothing", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 9], [0, 7]]}, "expect": {"commits": []}},
  {"name": "before one whole block the floor is zero", "input": {"op": "PauseRule.commits", "energies": [[20000, 9], 0, 200000, [0, 7]]}, "expect": {"commits": [18]}},
  {"name": "a frame is judged against the blocks complete before it", "input": {"op": "PauseRule.commits", "energies": [[20000, 10], [0, 7]]}, "expect": {"commits": [17]}},
  {"name": "an energy of 10,736 is not speech", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [10736, 10], [0, 7]]}, "expect": {"commits": []}},
  {"name": "an energy of 10,737 is speech", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [10737, 10], [0, 7]]}, "expect": {"commits": [27]}},
  {"name": "ten times the floor is speech", "input": {"op": "PauseRule.commits", "energies": [[2000, 10], [20000, 10], [0, 7]]}, "expect": {"commits": [27]}},
  {"name": "one less than ten times the floor is not speech", "input": {"op": "PauseRule.commits", "energies": [[2000, 10], [19999, 10], [0, 7]]}, "expect": {"commits": []}},
  {"name": "a block's energy rounds down", "input": {"op": "PauseRule.commits", "energies": [[2000, 9], 2009, [20000, 10], [0, 7]]}, "expect": {"commits": [27]}},
  {"name": "the floor is the lowest of the whole blocks", "input": {"op": "PauseRule.commits", "energies": [[5000, 10], [2000, 10], [9000, 10], [20000, 10], [0, 7]]}, "expect": {"commits": [47]}},
  {"name": "ten blocks back a block still holds the floor", "input": {"op": "PauseRule.commits", "energies": [[1000, 10], [5000, 90], [20000, 10], [0, 7]]}, "expect": {"commits": [117]}},
  {"name": "an eleventh block pushes the first out of the floor", "input": {"op": "PauseRule.commits", "energies": [[1000, 10], [5000, 100], [20000, 10], [0, 7]]}, "expect": {"commits": []}},
  {"name": "speech frames need not be in a row", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 5], [0, 3], [1000000, 5], [0, 7]]}, "expect": {"commits": [30]}},
  {"name": "one speech frame starts a quiet run again", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 10], [0, 6], 1000000, [0, 7]]}, "expect": {"commits": [34]}},
  {"name": "a pause before enough speech is not kept for later", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 9], [0, 7], 1000000, [0, 7]]}, "expect": {"commits": [34]}},
  {"name": "a long silence sends one commit", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 10], [0, 40]]}, "expect": {"commits": [27]}},
  {"name": "after a commit nine speech frames send nothing", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 10], [0, 7], [1000000, 9], [0, 7]]}, "expect": {"commits": [27]}},
  {"name": "after a commit ten speech frames and a pause send the next", "input": {"op": "PauseRule.commits", "energies": [[0, 10], [1000000, 10], [0, 7], [1000000, 10], [0, 7]]}, "expect": {"commits": [27, 44]}},
  {"name": "the floor does not start again at a commit", "input": {"op": "PauseRule.commits", "energies": [[2000, 10], [20000, 10], [0, 7], [15000, 10], [0, 7]]}, "expect": {"commits": [27]}}
]
