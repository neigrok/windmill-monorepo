  {
    "name": "minting an existing scope requires loading it first",
    "input": {
      "mint": {
        "type": "card",
        "scope": "self/probe",
        "count": 1,
        "borrow": false
      }
    },
    "expect": {
      "error": true
    }
  },
  {
    "name": "repeated mints share one act reservation set",
    "input": {
      "mint": {
        "type": "card",
        "scope": "self/probe",
        "count": 2,
        "borrow": true
      }
    },
    "expect": {
      "count": 2,
      "distinct": true,
      "committed": false
    }
  },
  {
    "name": "a new scope may mint before its governing create",
    "input": {
      "mint": {
        "type": "tag",
        "scope": "tree/b_00000001",
        "count": 1,
        "borrow": false,
        "new": true
      }
    },
    "expect": {
      "count": 1,
      "distinct": true,
      "committed": true
    }
  },
  {
    "name": "a caught invalid load scope still fails before minting",
    "input": {
      "mint": {
        "type": "card",
        "scope": "self/probe",
        "count": 1,
        "borrow": true,
        "caughtScope": "self/missing"
      }
    },
    "expect": {
      "error": true
    }
  }
