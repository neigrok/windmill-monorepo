    "expect": {
      "outcome": {
        "kind": "committed",
        "scopes": [
          "tree/b_00000001",
          "tree/b_00000002",
          "self/overlay/b_00000001"
        ],
        "counts": [
          1,
          1,
          1
        ],
        "held": false
      },
      "records": [
        [
          {
            "id": "meta",
            "title": "First"
          }
        ],
        [
          {
            "id": "meta",
            "title": "Second"
          }
        ]
      ]
    }
  },
  {
    "name": "a later gone record refuses the whole act including the earlier create",
    "input": {
      "segments": [
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "insert",
              "t": "card",
              "id": "card0001",
              "f": {
                "title": "First"
              },
              "below": null
            }
          ]
        },
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "update",
              "t": "card",
              "id": "card0404",
              "f": {
                "title": "Next"
              },
              "fields": [
                "title"
              ]
            }
          ]
        }
      ],
      "inspect": [
        {
          "scope": "self/probe",
          "t": "card"
        }
      ]
    },
    "expect": {
      "outcome": {
        "kind": "refused",
        "refusal": {
          "refused": {
            "code": "unknown-record",
            "subject": {
              "t": "card",
              "id": "card0404"
            },
            "detail": null,
            "path": "predicted"
          }
        }
      },
      "records": [
        []
      ]
    }
  },
  {
    "name": "one removal holds every segment and one Undo removes the entire act",
    "input": {
      "segments": [
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "insert",
              "t": "card",
              "id": "card0001",
              "f": {
                "title": "First"
              },
              "below": null
            }
          ]
        },
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "remove",
              "t": "card",
              "id": "card0001"
            }
          ]
        }
      ],
      "undo": true,
      "inspect": [
        {
          "scope": "self/probe",
          "t": "card"
        }
      ]
    },
    "expect": {
      "outcome": {
        "kind": "committed",
        "scopes": [
          "self/probe",
          "self/probe"
        ],
        "counts": [
          1,
          1
        ],
        "held": true
      },
      "records": [
        []
      ]
    }
  },
