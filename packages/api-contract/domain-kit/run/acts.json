          "scope": "tree/b_00000002",
          "plan": [
            {
              "op": "update",
              "t": "meta",
              "id": "meta",
              "f": {
                "title": "Second"
              },
              "fields": [
                "title"
              ]
            }
          ]
        },
        {
          "scope": "self/overlay/b_00000001",
          "plan": [
            {
              "op": "update",
              "t": "mark",
