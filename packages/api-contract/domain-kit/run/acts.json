[
  {
    "name": "later updates read earlier creates in the same act",
    "input": {
      "segments": [
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "insert",
              "t": "card",
              "id": "card0001",
              "f": {
                "title": "First"
              },
              "below": null
            }
          ]
        },
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "update",
              "t": "card",
              "id": "card0001",
              "f": {
                "title": "Next"
              },
              "fields": [
                "title"
              ]
            }
          ]
        }
      ],
      "inspect": [
        {
          "scope": "self/probe",
          "t": "card"
        }
      ]
    },
    "expect": {
      "outcome": {
        "kind": "committed",
        "scopes": [
          "self/probe",
          "self/probe"
        ],
        "counts": [
          1,
          1
        ],
        "held": false
      },
      "records": [
        [
          {
            "id": "card0001",
            "title": "Next"
          }
        ]
      ]
    }
  },
  {
    "name": "one act writes separate trees and an overlay",
