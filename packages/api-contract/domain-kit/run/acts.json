          "scope": "self/probe",
          "cmd": {
            "name": "probe.start",
            "args": {
              "id": "run00001",
              "startedAt": 5000,
              "join": false
            }
          },
          "predict": [
            {
              "op": "create",
              "t": "run",
              "id": "run00001",
              "f": {
                "startedAt": 5000,
                "label": "First"
              }
            }
          ],
          "plan": []
        },
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "update",
              "t": "run",
              "id": "run00001",
              "f": {
                "label": "Next"
              },
              "fields": [
                "label"
              ]
            }
          ]
        }
      ],
      "inspect": [
        {
          "scope": "self/probe",
          "t": "run"
        }
      ]
    },
    "expect": {
      "outcome": {
        "kind": "committed",
        "scopes": [
          "self/probe",
          "self/probe"
        ],
        "counts": [
          1,
          1
        ],
        "held": false
      },
      "records": [
        [
          {
            "id": "run00001",
            "title": null
          }
        ]
      ]
    }
