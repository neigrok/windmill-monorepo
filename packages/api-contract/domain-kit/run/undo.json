      "observe": [
        "tree/b_00000002"
      ],
      "segments": [
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "create",
              "t": "board",
              "id": "b_00000002"
            }
          ],
          "undo": [
            {
              "kind": "command",
              "command": "probe.unbranch",
              "input": {
                "parent": "b_00000001",
                "child": "b_00000002",
                "title": "Root"
              },
              "evidence": {
                "ownedFields": [],
                "unchangedCreatedRecords": [
                  {
                    "t": "board",
                    "id": "b_00000002"
                  }
                ],
                "unchangedCreatedScopes": [
                  "tree/b_00000002"
                ]
              }
            }
          ]
        },
        {
          "scope": "tree/b_00000002",
          "plan": [
            {
              "op": "create",
              "t": "meta",
              "id": "meta",
              "f": {
                "title": "Child"
              },
              "fields": [
                "title"
              ]
            }
          ],
          "undo": []
        }
      ],
      "steps": [
        "sync",
        "undo",
        "sync",
        "read"
      ],
      "inspect": [
        {
          "scope": "self/probe",
          "t": "board"
