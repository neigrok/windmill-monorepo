  {
    "name": "the Undo of an act still held cancels it in place",
    "input": {
      "before": [
        [
          {
            "scope": "self/probe",
            "plan": [
              {
                "op": "insert",
                "t": "card",
                "id": "card0001",
                "f": {
                  "title": "Old",
                  "claim": ""
                },
                "below": null
              }
            ]
          }
        ]
      ],
      "segments": [
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "remove",
              "t": "card",
              "id": "card0001"
            }
          ],
          "undo": [
            {
              "kind": "fields",
              "restoreCommand": "probe.restore",
              "targets": [
                {
                  "t": "card",
                  "id": "card0001",
                  "slot": {
                    "kind": "field",
                    "name": "title"
                  }
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        "undo"
      ],
      "inspect": [
        {
          "scope": "self/probe",
          "t": "card"
        }
      ]
    },
    "expect": {
      "outcome": {
        "kind": "committed",
        "counts": [
          1
        ],
        "held": true
      },
      "results": [
        {
          "kind": "cancelled",
          "changed": true
        }
      ],
      "records": [
        [
          {
            "id": "card0001",
            "title": "Old"
          }
        ]
      ]
    }
  },
