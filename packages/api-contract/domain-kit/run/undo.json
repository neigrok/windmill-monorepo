[
  {
    "name": "an opted act's Undo restores both of its scopes, and its Redo takes the act's values back",
    "input": {
      "observe": [
        "tree/b_00000001"
      ],
      "before": [
        [
          {
            "scope": "self/probe",
            "plan": [
              {
                "op": "create",
                "t": "board",
                "id": "b_00000001"
              },
              {
                "op": "insert",
                "t": "card",
                "id": "card0001",
                "f": {
                  "title": "Old",
                  "claim": ""
                },
                "below": null
              }
            ]
          },
          {
            "scope": "tree/b_00000001",
            "plan": [
              {
                "op": "create",
                "t": "meta",
                "id": "meta",
                "f": {
                  "title": "Root"
                },
                "fields": [
                  "title"
                ]
              }
            ]
          }
        ]
      ],
      "segments": [
        {
          "scope": "self/probe",
          "plan": [
            {
              "op": "update",
              "t": "card",
              "id": "card0001",
              "f": {
                "title": "New"
              },
              "fields": [
                "title"
              ]
            }
          ],
          "undo": [
            {
              "kind": "fields",
              "restoreCommand": "probe.restore",
              "targets": [
                {
                  "t": "card",
                  "id": "card0001",
                  "slot": {
                    "kind": "field",
                    "name": "title"
                  }
                }
              ]
            }
          ]
        },
        {
          "scope": "tree/b_00000001",
          "plan": [
            {
              "op": "update",
              "t": "meta",
              "id": "meta",
              "f": {
                "title": "Grown"
              },
              "fields": [
                "title"
              ]
            }
          ],
          "undo": [
            {
              "kind": "fields",
              "restoreCommand": "probe.restoreTree",
              "targets": [
                {
                  "t": "meta",
                  "id": "meta",
                  "slot": {
                    "kind": "field",
                    "name": "title"
                  }
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        "sync",
        "undo",
        "sync",
        "read",
        "redo",
        "sync",
        "read"
      ],
      "inspect": [
        {
          "scope": "self/probe",
          "t": "card"
        },
        {
          "scope": "tree/b_00000001",
          "t": "meta"
        }
      ]
    },
    "expect": {
      "outcome": {
        "kind": "committed",
        "counts": [
          1,
          1
        ],
        "held": false
      },
      "results": [
        {
          "kind": "pending",
          "localChanged": true
        },
        {
          "kind": "settled",
          "changed": true,
          "appliedCount": 2,
          "skippedCount": 0
        },
        {
          "kind": "pending",
          "localChanged": true
        },
        {
          "kind": "settled",
          "changed": true,
          "appliedCount": 2,
          "skippedCount": 0
        }
      ],
      "records": [
        [
          {
            "id": "card0001",
            "title": "New"
          }
        ],
        [
          {
            "id": "meta",
            "title": "Grown"
          }
        ]
      ]
    }
  },
