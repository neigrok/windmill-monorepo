  {
    "name": "a draft's save of a type that saves reversibly is an act: its Undo takes the text back, and its Redo writes it again",
    "input": {
      "observe": [
        "tree/b_00000001",
        "self/overlay/b_00000001"
      ],
      "before": [
        [
          {
            "scope": "self/probe",
            "plan": [
              {
                "op": "create",
                "t": "board",
                "id": "b_00000001"
              }
            ]
          },
          {
            "scope": "tree/b_00000001",
            "plan": [
              {
                "op": "create",
                "t": "tag",
                "id": "tagm0001",
                "f": {
                  "label": "Oak"
                }
              }
            ]
          },
          {
            "scope": "self/overlay/b_00000001",
            "plan": [
              {
                "op": "create",
                "t": "mark",
                "id": "tagm0001",
                "f": {
                  "memo": "buy milk"
                },
                "fields": [
                  "memo"
                ]
              }
            ]
          }
        ]
      ],
      "save": {
        "t": "reversibleMark",
        "id": "tagm0001",
        "current": {
          "done": null,
          "memo": "buy milk and eggs"
        }
      },
      "steps": [
        "sync",
        "undo",
        "sync",
        "read",
        "redo",
        "sync",
        "read"
      ],
      "inspect": [
        {
          "scope": "self/overlay/b_00000001",
          "t": "reversibleMark",
          "field": "memo"
        }
      ]
    },
    "expect": {
      "outcome": {
        "kind": "saved"
      },
      "records": [
        [
          {
            "id": "tagm0001",
            "memo": "buy milk and eggs"
          }
        ]
      ],
      "results": [
        {
          "kind": "pending",
          "localChanged": true
        },
        {
          "appliedCount": 1,
          "changed": true,
          "kind": "settled",
          "skippedCount": 0
        },
        {
          "kind": "pending",
          "localChanged": true
        },
        {
          "appliedCount": 1,
          "changed": true,
          "kind": "settled",
          "skippedCount": 0
        }
      ]
    }
