[
  {
    "name": "the epoch is 1970-01-01",
    "input": {"op": "fromInstant", "ms": 0, "offsetSeconds": 0},
    "expect": {"day": "1970-01-01"}
  },
  {
    "name": "one ms before the epoch is 1969-12-31: floor division",
    "input": {"op": "fromInstant", "ms": -1, "offsetSeconds": 0},
    "expect": {"day": "1969-12-31"}
  },
  {
    "name": "exactly one day before the epoch is 1969-12-31",
    "input": {"op": "fromInstant", "ms": -86400000, "offsetSeconds": 0},
    "expect": {"day": "1969-12-31"}
  },
  {
    "name": "one ms more than a day before the epoch is 1969-12-30",
    "input": {"op": "fromInstant", "ms": -86400001, "offsetSeconds": 0},
    "expect": {"day": "1969-12-30"}
  },
  {
    "name": "the default now is 2027-01-15 in UTC",
    "input": {"op": "fromInstant", "ms": 1800000000000, "offsetSeconds": 0},
    "expect": {"day": "2027-01-15"}
  },
  {
    "name": "a negative offset moves 08:00 UTC back to the previous day",
    "input": {"op": "fromInstant", "ms": 1800000000000, "offsetSeconds": -32400},
    "expect": {"day": "2027-01-14"}
  },
  {
    "name": "a positive offset of +14h keeps 08:00 UTC on the same day",
    "input": {"op": "fromInstant", "ms": 1800000000000, "offsetSeconds": 50400},
    "expect": {"day": "2027-01-15"}
  },
  {
    "name": "+2h moves 22:00 UTC to midnight of the next day",
    "input": {"op": "fromInstant", "ms": 1800050400000, "offsetSeconds": 7200},
    "expect": {"day": "2027-01-16"}
  },
  {
    "name": "+05:30 moves 19:30 UTC to the next day",
    "input": {"op": "fromInstant", "ms": 1800041400000, "offsetSeconds": 19800},
    "expect": {"day": "2027-01-16"}
  },
  {
    "name": "midnight UTC belongs to its own day",
    "input": {"op": "fromInstant", "ms": 1799971200000, "offsetSeconds": 0},
    "expect": {"day": "2027-01-15"}
  },
  {
    "name": "midnight UTC less one second of offset is the previous day",
    "input": {"op": "fromInstant", "ms": 1799971200000, "offsetSeconds": -1},
    "expect": {"day": "2027-01-14"}
  },
  {
    "name": "a negative instant with a positive offset crosses back to the epoch",
    "input": {"op": "fromInstant", "ms": -3600000, "offsetSeconds": 3600},
    "expect": {"day": "1970-01-01"}
  },
  {
    "name": "the epoch with a negative offset is 1969-12-31",
    "input": {"op": "fromInstant", "ms": 0, "offsetSeconds": -1},
    "expect": {"day": "1969-12-31"}
  },
  {
    "name": "noon on a leap day is 2024-02-29",
    "input": {"op": "fromInstant", "ms": 1709208000000, "offsetSeconds": 0},
    "expect": {"day": "2024-02-29"}
  },
  {
    "name": "2100 is not a leap year: midnight of 2100-03-01",
    "input": {"op": "fromInstant", "ms": 4107542400000, "offsetSeconds": 0},
    "expect": {"day": "2100-03-01"}
  },
  {
    "name": "one ms before 2100-03-01 is 2100-02-28",
    "input": {"op": "fromInstant", "ms": 4107542399999, "offsetSeconds": 0},
    "expect": {"day": "2100-02-28"}
  },
  {
    "name": "a year below 1000 is zero-padded to four digits",
    "input": {"op": "fromInstant", "ms": -30610267200000, "offsetSeconds": 0},
    "expect": {"day": "0999-12-31"}
  },
  {
    "name": "the first ms of 0001-01-01",
    "input": {"op": "fromInstant", "ms": -62135596800000, "offsetSeconds": 0},
    "expect": {"day": "0001-01-01"}
  },
  {
    "name": "the last ms of 9999-12-31",
    "input": {"op": "fromInstant", "ms": 253402300799999, "offsetSeconds": 0},
    "expect": {"day": "9999-12-31"}
  },
