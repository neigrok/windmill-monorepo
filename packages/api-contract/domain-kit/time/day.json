  {
    "name": "adding one day crosses a month",
    "input": {"op": "adding", "day": "2027-01-31", "days": 1},
    "expect": {"day": "2027-02-01"}
  },
  {
    "name": "adding one day crosses a year",
    "input": {"op": "adding", "day": "2027-12-31", "days": 1},
    "expect": {"day": "2028-01-01"}
  },
  {
    "name": "adding one day reaches a leap day",
    "input": {"op": "adding", "day": "2024-02-28", "days": 1},
    "expect": {"day": "2024-02-29"}
  },
  {
    "name": "adding one day skips a missing leap day",
    "input": {"op": "adding", "day": "2023-02-28", "days": 1},
    "expect": {"day": "2023-03-01"}
  },
  {
    "name": "1900 has no leap day",
    "input": {"op": "adding", "day": "1900-02-28", "days": 1},
    "expect": {"day": "1900-03-01"}
  },
  {
    "name": "2000 has a leap day",
    "input": {"op": "adding", "day": "2000-02-28", "days": 1},
    "expect": {"day": "2000-02-29"}
  },
  {
    "name": "adding -1 goes back across a month",
    "input": {"op": "adding", "day": "2027-03-01", "days": -1},
    "expect": {"day": "2027-02-28"}
  },
  {
    "name": "adding -1 goes back across a year",
    "input": {"op": "adding", "day": "2027-01-01", "days": -1},
    "expect": {"day": "2026-12-31"}
  },
  {
    "name": "adding -1 goes back across the epoch",
    "input": {"op": "adding", "day": "1970-01-01", "days": -1},
    "expect": {"day": "1969-12-31"}
  },
  {
    "name": "adding 0 is the same day",
    "input": {"op": "adding", "day": "2027-01-15", "days": 0},
    "expect": {"day": "2027-01-15"}
  },
  {
    "name": "adding 366 days spans a leap year",
    "input": {"op": "adding", "day": "2024-01-01", "days": 366},
    "expect": {"day": "2025-01-01"}
  },
  {
    "name": "adding -146097 days is exactly 400 years back",
    "input": {"op": "adding", "day": "2027-01-15", "days": -146097},
    "expect": {"day": "1627-01-15"}
  },
  {
    "name": "adding -1 reaches the first day",
    "input": {"op": "adding", "day": "0001-01-02", "days": -1},
    "expect": {"day": "0001-01-01"}
  },
  {
    "name": "the next day is 1 day away",
    "input": {"op": "daysUntil", "day": "2027-01-15", "other": "2027-01-16"},
    "expect": {"days": 1}
  },
  {
    "name": "the previous day is -1 day away",
    "input": {"op": "daysUntil", "day": "2027-01-16", "other": "2027-01-15"},
    "expect": {"days": -1}
  },
  {
    "name": "a day is 0 days from itself",
    "input": {"op": "daysUntil", "day": "2027-01-15", "other": "2027-01-15"},
    "expect": {"days": 0}
  },
  {
    "name": "a leap year is 366 days",
    "input": {"op": "daysUntil", "day": "2024-01-01", "other": "2025-01-01"},
    "expect": {"days": 366}
  },
  {
    "name": "a common year is 365 days",
    "input": {"op": "daysUntil", "day": "2023-01-01", "other": "2024-01-01"},
    "expect": {"days": 365}
  },
  {
    "name": "from the epoch to the default today",
    "input": {"op": "daysUntil", "day": "1970-01-01", "other": "2027-01-15"},
    "expect": {"days": 20833}
  },
  {
    "name": "backwards across the end of February",
    "input": {"op": "daysUntil", "day": "2027-03-01", "other": "2027-02-28"},
    "expect": {"days": -1}
  },
  {
    "name": "from the first to the last representable day",
    "input": {"op": "daysUntil", "day": "0001-01-01", "other": "9999-12-31"},
    "expect": {"days": 3652058}
