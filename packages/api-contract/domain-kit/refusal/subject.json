[
  {
    "name": "cap names the first record the plan creates of the capped type",
    "input": {
      "source": "commit",
      "plan": [
        {"op": "update", "t": "card", "id": "cardA001", "f": {"title": "A"}, "fields": ["title"]},
        {"op": "insert", "t": "card", "id": "cardN001", "f": {"title": "N1"}, "below": null},
        {"op": "insert", "t": "card", "id": "cardN002", "f": {"title": "N2"}, "below": null}
      ],
      "code": "cap", "detail": {"type": "card", "cap": 3}
    },
    "expect": {"subject": {"t": "card", "id": "cardN001"}}
  },
  {
    "name": "cap passes over records the plan creates of another type",
    "input": {
      "source": "commit",
      "plan": [
        {"op": "create", "t": "lap", "id": "lap00002", "f": {"runId": "run00001"}},
        {"op": "insert", "t": "card", "id": "cardN001", "f": {"title": "N1"}, "below": null}
      ],
      "code": "cap", "detail": {"type": "card", "cap": 3}
    },
    "expect": {"subject": {"t": "card", "id": "cardN001"}}
  },
  {
    "name": "too-large names the first record the plan writes",
    "input": {
      "source": "commit",
      "plan": [
        {"op": "update", "t": "card", "id": "cardB001", "f": {"title": "B"}, "fields": ["title"]},
        {"op": "insert", "t": "card", "id": "cardN001", "f": {"title": "N1"}, "below": null}
      ],
      "code": "too-large"
    },
    "expect": {"subject": {"t": "card", "id": "cardB001"}}
  },
  {
    "name": "the first record written passes over a guardRead and a device write",
    "input": {
      "source": "commit",
      "plan": [
        {"op": "device", "key": "rack", "value": {"n": 1}},
        {"op": "guardRead", "t": "card", "id": "cardB001", "fields": ["title"]},
        {"op": "update", "t": "card", "id": "cardA001", "f": {"title": "A"}, "fields": ["title"]}
      ],
      "code": "too-large"
    },
    "expect": {"subject": {"t": "card", "id": "cardA001"}}
  },
  {
    "name": "a removal is a write: a plan that removes first names the removed record",
    "input": {
      "source": "commit",
      "plan": [
        {"op": "remove", "t": "lap", "id": "lap00001"},
        {"op": "create", "t": "lap", "id": "lap00002", "f": {"runId": "run00001"}}
      ],
      "code": "too-large"
    },
    "expect": {"subject": {"t": "lap", "id": "lap00001"}}
  },
  {
    "name": "scope-dead names the first record the plan writes, a keyed tuple id included",
    "input": {
      "source": "commit", "scope": "tree/b_00000001",
      "plan": [
        {"op": "create", "t": "link", "id": ["ash", "oak"], "f": {"strength": 2}},
        {"op": "update", "t": "meta", "id": "meta", "f": {"title": "Plan"}, "fields": ["title"]}
      ],
      "code": "scope-dead"
    },
    "expect": {"subject": {"t": "link", "id": ["ash", "oak"]}}
  },
  {
    "name": "a plan that writes no record, only a command, names no subject",
    "input": {
      "source": "commit",
      "cmd": {"name": "probe.start", "args": {"id": "run00001", "startedAt": 1800000000000, "join": false}},
      "plan": [], "code": "too-large"
    },
    "expect": {"subject": null}
  },
  {
    "name": "a notice names the record of its first delta",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "cap", "detail": {"type": "card", "cap": 3},
        "content": {
          "d": [
            {"t": "card", "id": "cardN001", "born": "5000:0:r_aaaaaaaaaaaa", "life": ["alive", "5000:0:r_aaaaaaaaaaaa"], "f": {"title": ["Fourth", "5000:0:r_aaaaaaaaaaaa"]}},
            {"t": "card", "id": "cardA001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["A", "5001:0:r_aaaaaaaaaaaa"]}}
          ]
        },
        "at": 5100
      }
    },
    "expect": {"subject": {"t": "card", "id": "cardN001"}, "gestureId": "g1"}
  },
  {
    "name": "the first delta wins over the command",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g2/0", "scope": "self/probe", "code": "invalid",
        "content": {
          "d": [
            {"t": "card", "id": "cardA001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["A", "5001:0:r_aaaaaaaaaaaa"]}}
          ],
          "cmd": {"name": "probe.end", "args": {"runId": "run00001", "endedAt": 5000}}
        },
        "at": 5100
      }
    },
    "expect": {"subject": {"t": "card", "id": "cardA001"}, "gestureId": "g2"}
  },
  {
    "name": "a notice without a delta names the first ref argument of its command",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g3/0", "scope": "self/probe", "code": "record-dead",
        "content": {"cmd": {"name": "probe.end", "args": {"endedAt": 5000, "runId": "run00001"}}},
        "at": 5100
      }
    },
    "expect": {"subject": {"t": "run", "id": "run00001"}, "gestureId": "g3"}
  },
  {
    "name": "ref arguments are taken in JCS key order: probe.copy names dst before src",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g4/0", "scope": "self/probe", "code": "id-taken",
        "content": {"cmd": {"name": "probe.copy", "args": {"src": "b_00000001", "dst": "b_00000002"}}},
        "at": 5100
      }
    },
    "expect": {"subject": {"t": "board", "id": "b_00000002"}, "gestureId": "g4"}
  },
  {
    "name": "a start command names its run id, the one ref among its arguments",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g5/0", "scope": "self/probe", "code": "id-taken",
        "content": {"cmd": {"name": "probe.start", "args": {"id": "run0000b1", "startedAt": 5000, "join": true}}},
        "at": 5100
      }
    },
    "expect": {"subject": {"t": "run", "id": "run0000b1"}, "gestureId": "g5"}
  },
  {
    "name": "a notice with no delta and no command names no subject, even with dependents",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g6/0", "scope": "self/probe", "code": "invalid",
        "content": {
          "d": [],
          "dependents": [
            {
              "d": [
                {"t": "card", "id": "cardA001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["A", "5001:0:r_aaaaaaaaaaaa"]}}
              ]
            }
          ]
        },
        "at": 5100
      }
    },
    "expect": {"subject": null, "gestureId": "g6"}
  },
  {
    "name": "the gesture id is the text between notice: and the last slash",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g12/10", "scope": "self/probe", "code": "invalid",
        "content": {
          "d": [
            {"t": "card", "id": "cardA001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["A", "5001:0:r_aaaaaaaaaaaa"]}}
          ]
        },
        "at": 5100
      }
    },
    "expect": {"subject": {"t": "card", "id": "cardA001"}, "gestureId": "g12"}
  },
  {
    "name": "a gesture id holding a slash keeps it",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:coach/call-7/0", "scope": "self/probe", "code": "invalid",
        "content": {
          "d": [
            {"t": "card", "id": "cardA001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["A", "5001:0:r_aaaaaaaaaaaa"]}}
          ]
        },
        "at": 5100
      }
    },
    "expect": {"subject": {"t": "card", "id": "cardA001"}, "gestureId": "coach/call-7"}
  },
  {
    "name": "values of a record are the fields its deltas wrote",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "cap", "detail": {"type": "card", "cap": 3},
        "content": {
          "d": [
            {"t": "card", "id": "cardN001", "born": "5000:0:r_aaaaaaaaaaaa", "life": ["alive", "5000:0:r_aaaaaaaaaaaa"], "f": {"title": ["Fourth", "5000:0:r_aaaaaaaaaaaa"], "body": ["b", "5000:0:r_aaaaaaaaaaaa"], "size": [null, "5000:0:r_aaaaaaaaaaaa"]}}
          ]
        },
        "at": 5100
      },
      "of": {"t": "card", "id": "cardN001"}
    },
    "expect": {
      "subject": {"t": "card", "id": "cardN001"}, "gestureId": "g1",
      "values": {"title": "Fourth", "body": "b", "size": null}
    }
  },
  {
    "name": "values of a record the content never wrote are empty",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "invalid",
        "content": {
          "d": [
            {"t": "card", "id": "cardA001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["A", "5001:0:r_aaaaaaaaaaaa"]}}
          ]
        },
        "at": 5100
      },
      "of": {"t": "card", "id": "cardB001"}
    },
    "expect": {"subject": {"t": "card", "id": "cardA001"}, "gestureId": "g1", "values": {}}
  },
  {
    "name": "values are per type: another type with the same id is not the record",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "invalid",
        "content": {
          "d": [
            {"t": "lap", "id": "abcd1234", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"weight": [40, "5000:0:r_aaaaaaaaaaaa"]}},
            {"t": "card", "id": "abcd1234", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["A", "5001:0:r_aaaaaaaaaaaa"]}}
          ]
        },
        "at": 5100
      },
      "of": {"t": "card", "id": "abcd1234"}
    },
    "expect": {"subject": {"t": "lap", "id": "abcd1234"}, "gestureId": "g1", "values": {"title": "A"}}
  },
  {
    "name": "values of a delete are empty",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "invalid",
        "content": {
          "d": [
            {"t": "card", "id": "cardA001", "born": "1000:0:r_aaaaaaaaaaaa", "life": ["dead", "5000:0:r_aaaaaaaaaaaa"]}
          ]
        },
        "at": 5100
      },
      "of": {"t": "card", "id": "cardA001"}
    },
    "expect": {"subject": {"t": "card", "id": "cardA001"}, "gestureId": "g1", "values": {}}
  },
  {
    "name": "values give a text field as its text",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/overlay/b_00000001", "code": "too-large",
        "content": {
          "d": [
            {"t": "mark", "id": "oak", "f": {"done": [true, "5000:0:r_aaaaaaaaaaaa"]}, "x": {"memo": {"text": "a note to keep", "base": {"text": ""}}}}
          ]
        },
        "at": 5100
      },
      "of": {"t": "mark", "id": "oak"}
    },
    "expect": {
      "subject": {"t": "mark", "id": "oak"}, "gestureId": "g1", "values": {"done": true, "memo": "a note to keep"}
    }
  },
  {
    "name": "values of a keyed tuple id",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "tree/b_00000001", "code": "invalid",
        "content": {
          "d": [
            {"t": "link", "id": ["ash", "oak"], "life": ["alive", "5000:0:r_aaaaaaaaaaaa"], "f": {"strength": [4, "5000:0:r_aaaaaaaaaaaa"]}}
          ]
        },
        "at": 5100
      },
      "of": {"t": "link", "id": ["ash", "oak"]}
    },
    "expect": {"subject": {"t": "link", "id": ["ash", "oak"]}, "gestureId": "g1", "values": {"strength": 4}}
  },
  {
    "name": "values fold the dependents after the content, a later write replacing an earlier one",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "cap", "detail": {"type": "card", "cap": 3},
        "content": {
          "d": [
            {"t": "card", "id": "cardN001", "born": "5000:0:r_aaaaaaaaaaaa", "life": ["alive", "5000:0:r_aaaaaaaaaaaa"], "f": {"title": ["Fourth", "5000:0:r_aaaaaaaaaaaa"], "body": ["b", "5000:0:r_aaaaaaaaaaaa"]}}
          ],
          "dependents": [
            {
              "d": [
                {"t": "card", "id": "cardN001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["Renamed", "5001:0:r_aaaaaaaaaaaa"]}}
              ]
            },
            {
              "d": [
                {"t": "card", "id": "cardN001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"tier": ["review", "5002:0:r_aaaaaaaaaaaa"]}}
              ]
            }
          ]
        },
        "at": 5100
      },
      "of": {"t": "card", "id": "cardN001"}
    },
    "expect": {
      "subject": {"t": "card", "id": "cardN001"}, "gestureId": "g1",
      "values": {"title": "Renamed", "body": "b", "tier": "review"}
    }
  },
  {
    "name": "values fold nested dependents depth first",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "cap", "detail": {"type": "card", "cap": 3},
        "content": {
          "d": [
            {"t": "card", "id": "cardN001", "born": "5000:0:r_aaaaaaaaaaaa", "life": ["alive", "5000:0:r_aaaaaaaaaaaa"], "f": {"title": ["One", "5000:0:r_aaaaaaaaaaaa"]}}
          ],
          "dependents": [
            {
              "d": [
                {"t": "card", "id": "cardN001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["Two", "5001:0:r_aaaaaaaaaaaa"]}}
              ],
              "dependents": [
                {
                  "d": [
                    {"t": "card", "id": "cardN001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["Three", "5002:0:r_aaaaaaaaaaaa"]}}
                  ]
                }
              ]
            },
            {
              "d": [
                {"t": "card", "id": "cardN001", "born": "1000:0:r_aaaaaaaaaaaa", "f": {"title": ["Four", "5003:0:r_aaaaaaaaaaaa"]}}
              ]
            }
          ]
        },
        "at": 5100
      },
      "of": {"t": "card", "id": "cardN001"}
    },
    "expect": {"subject": {"t": "card", "id": "cardN001"}, "gestureId": "g1", "values": {"title": "Four"}}
  },
  {
    "name": "values reach a record only a dependent wrote",
    "input": {
      "source": "notice",
      "notice": {
        "id": "notice:g1/0", "scope": "self/probe", "code": "id-taken",
        "content": {
          "cmd": {"name": "probe.start", "args": {"id": "run0000b1", "startedAt": 5000, "join": true}},
          "dependents": [
            {
              "d": [
                {"t": "lap", "id": "lap00001", "born": "5001:0:r_aaaaaaaaaaaa", "life": ["alive", "5001:0:r_aaaaaaaaaaaa"], "f": {"runId": ["run0000b1", "5001:0:r_aaaaaaaaaaaa"], "at": [5001, "5001:0:r_aaaaaaaaaaaa"], "weight": [40, "5001:0:r_aaaaaaaaaaaa"]}}
              ]
            },
            {
              "d": [
                {"t": "lap", "id": "lap00001", "born": "5001:0:r_aaaaaaaaaaaa", "f": {"weight": [45, "5002:0:r_aaaaaaaaaaaa"]}}
              ]
            }
          ]
        },
        "at": 5100
      },
      "of": {"t": "lap", "id": "lap00001"}
    },
    "expect": {
      "subject": {"t": "run", "id": "run0000b1"}, "gestureId": "g1",
      "values": {"runId": "run0000b1", "at": 5001, "weight": 45}
    }
  }
]
