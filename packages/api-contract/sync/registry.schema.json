{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windmill.works/schemas/sync/registry.schema.json",
  "title": "Windmill sync registry",
  "description": "The machine-readable registry of engine.md §2.4: every synced type, field and command, and each product's device-scope rows. Swift, Kotlin, JS and C++ code generation reads this format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry",
    "version",
    "minVersion",
    "products",
    "types",
    "commands"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry": {
      "description": "The registry's name.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "description": "The registry version every request carries, in the Sync-Schema header or, on the live upgrade, the schema query parameter; answered as hello.schema (§9.1, §9.2).",
      "type": "integer",
      "minimum": 1
    },
    "minVersion": {
      "description": "The oldest registry version the server still accepts, answered as hello.minSchema (§9.2).",
      "type": "integer",
      "minimum": 1
    },
    "products": {
      "description": "Each product the registry declares, keyed by product name.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/productName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/product"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "productName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "typeName": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "regex": {
      "description": "A portable pattern (engine.md §2.4): printable ASCII, `^` and `$` around literal characters, escaped syntax characters, bracket classes of literals and ranges, groups holding any alternation, and the greedy quantifiers ? * + {n,m}; matched against the whole value. `.`, class escapes, negated classes, backreferences, lookaround, lazy quantifiers and flags are outside it.",
      "type": "string",
      "pattern": "^\\^[ -~]*\\$$"
    },
    "scope": {
      "description": "The scope kind a type or command lives in (D-4): a product scope `product:<name>`, a governed `tree` scope, or an account's `overlay` of a tree.",
      "type": "string",
      "pattern": "^(product:[a-z][a-z0-9]*|tree|overlay)$"
    },
    "origins": {
      "description": "Who may write the type by a delta outside a command, or call the command (D-23). A type's origins always include replica (§2.4).",
      "type": "array",
      "items": {
        "enum": [
          "replica",
          "server"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surfaces": {
          "description": "The surfaces that carry the product; a bound replica subscribes the product scopes of the products its surface carries (§7.9).",
          "type": "array",
          "items": {
            "enum": [
              "web",
              "ios",
              "android"
            ]
          },
          "uniqueItems": true
        },
        "device": {
          "description": "The rows of the product's device scope `device/<product>` (D-4, §2.5 DeviceRow): never sent and never merged, moved at sign-in, retained with dormant account work on sign-out Keep and deleted on Discard (§7.10).",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fieldName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/deviceRow"
          }
        },
        "codes": {
          "description": "The refusal codes the product's check and commands answer beyond the engine's (§2.4, §9.6): none is an engine code, and no two products declare one.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      }
    },
    "deviceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyPattern"
      ],
      "properties": {
        "keyPattern": {
          "$ref": "#/$defs/regex"
        },
        "localOnly": {
          "description": "A synced record may reference this row as `localOnly`: the content stays on the device that holds the row, and no sign-in uploads it.",
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/domain"
        }
      }
    },
    "key": {
      "description": "A keyed type's natural key (D-8): an id of another type, or an array of such ids whose JCS is the identity (§9.1). Without `key`, the key is a string matching idPattern.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/typeName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tuple"
          ],
          "properties": {
            "tuple": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "ref"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/fieldName"
                  },
                  "ref": {
                    "$ref": "#/$defs/typeName"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "scope",
        "identity",
        "life",
        "origins",
        "fields"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "identity": {
          "description": "The identity class (D-8).",
          "enum": [
            "minted",
            "derived",
            "keyed",
            "singleton"
          ]
        },
        "idSpace": {
          "description": "Minted and derived types: ids unique within the scope, or across every scope of the type (§4.2 `foreign`).",
          "enum": [
            "scope",
            "global"
          ]
        },
        "idPattern": {
          "description": "Every id of the type matches it (§6.1 step 2). A tuple-keyed type has none: each part matches its referenced type's pattern.",
          "$ref": "#/$defs/regex"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "singletonId": {
          "description": "A singleton's one fixed id.",
          "type": "string"
        },
        "derive": {
          "description": "A derived type's label rule (D-26): the fallback id base for a label with no alphanumeric byte.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fallback"
          ],
          "properties": {
            "fallback": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        },
        "seeded": {
          "description": "A minted type whose ids may be seeded (D-8): `<seed>-<n>` with a seed of at most seedMax characters and 1 <= n <= ordinalMax, fitting idPattern.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seedMax",
            "ordinalMax"
          ],
          "properties": {
            "seedMax": {
              "type": "integer",
              "minimum": 1
            },
            "ordinalMax": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "life": {
          "description": "Whether records carry a life register (D-6). Minted and derived types always do; singletons never do.",
          "type": "boolean"
        },
        "wholePut": {
          "description": "On a keyed type with life: each record is one fact, whose newest save wins whole. Every put that leaves it present writes every client-written lattice field and a fresh life at one stamp, so a newer save beats an older delete (engine.md §2.4, §7.1 step 4, INV-2).",
          "const": true
        },
        "revivable": {
          "description": "Minted and derived types: death is terminal unless revivable (D-8, §4.3).",
          "type": "boolean"
        },
        "deadRows": {
          "description": "Types with life: a dead row is kept in the typed table, or deleted with sync_spent keeping its id (§2.2, §6.10).",
          "enum": [
            "keep",
            "spent"
          ]
        },
        "governs": {
          "description": "The type's records each govern a scope of this kind, created and killed with the record (D-5, §6.1 step 15).",
          "const": "tree"
        },
        "origins": {
          "$ref": "#/$defs/origins"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fieldName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "cap": {
          "description": "The ceiling on alive records of the type in one scope, enforced by the growth rule (D-24, §6.1 step 12).",
          "type": "integer",
          "minimum": 1
        },
        "visibleWhen": {
          "description": "Types without life: the record is visible iff one of these fields holds a value other than null or \"\" (§2.4, §7.6).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldName"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary": {
          "description": "A record of this type in the product scope makes the account hold records in the product (§9.2 holdsRecords).",
          "const": true
        },
        "mint": {
          "description": "How a CSPRNG id of a minted or derived type is minted (D-8): the prefix, then `length` characters drawn uniformly from `alphabet`. Every minted id matches idPattern.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefix",
            "alphabet",
            "length"
          ],
          "properties": {
            "prefix": {
              "type": "string"
            },
            "alphabet": {
              "type": "string",
              "minLength": 2
            },
            "length": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity": {
                "enum": [
                  "minted",
                  "derived"
                ]
              }
            }
          },
          "then": {
            "required": [
              "idSpace",
              "idPattern",
              "revivable",
              "deadRows",
              "mint"
            ],
            "properties": {
              "life": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity": {
                "const": "derived"
              }
            }
          },
          "then": {
            "required": [
              "derive"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "identity": {
                "const": "singleton"
              }
            }
          },
          "then": {
            "required": [
              "singletonId",
              "idPattern"
            ],
            "properties": {
              "life": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity": {
                "const": "keyed"
              },
              "life": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "deadRows"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "key"
              ]
            }
          },
          "then": {
            "required": [
              "idPattern"
            ]
          }
        },
        {
          "description": "A governing type's ids are global: a tree scope is keyed by the id alone (D-5).",
          "if": {
            "required": [
              "governs"
            ]
          },
          "then": {
            "properties": {
              "idSpace": {
                "const": "global"
              }
            }
          }
        },
        {
          "description": "An order field (a fracKey domain, D-25) belongs to a minted or derived type.",
          "if": {
            "properties": {
              "identity": {
                "enum": [
                  "keyed",
                  "singleton"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": {
                  "not": {
                    "required": [
                      "domain"
                    ],
                    "properties": {
                      "domain": {
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "fracKey"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "description": "A whole put is for keyed types with life, with no text field and every client-written field lww (§2.4).",
          "if": {
            "required": [
              "wholePut"
            ]
          },
          "then": {
            "properties": {
              "identity": {
                "const": "keyed"
              },
              "life": {
                "const": true
              },
              "fields": {
                "additionalProperties": {
                  "not": {
                    "properties": {
                      "kind": {
                        "const": "text"
                      }
                    }
                  },
                  "if": {
                    "properties": {
                      "writer": {
                        "const": "client"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "lww"
                      }
                    }
                  }
                }
              }
            },
            "required": [
              "life"
            ]
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "writer"
      ],
      "properties": {
        "kind": {
          "description": "The field kind (D-9).",
          "enum": [
            "lww",
            "ranked",
            "fww",
            "const",
            "time",
            "serial",
            "text"
          ]
        },
        "writer": {
          "description": "`server`: only the server writes the field; a client-origin delta writing it is refused invalid (§4.4).",
          "enum": [
            "client",
            "server"
          ]
        },
        "ref": {
          "description": "The field holds an id of this type (D-10).",
          "$ref": "#/$defs/typeName"
        },
        "parent": {
          "description": "The one ref field whose target must be alive (§6.1 step 9).",
          "const": true
        },
        "unit": {
          "description": "The unit of `min` and `max`: Unicode code points or UTF-8 bytes. A string value is measured itself; any other value by its JCS encoding.",
          "enum": [
            "chars",
            "bytes"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "serialNext": {
          "description": "A serial field numbers new records 1 + the maximum over alive records sharing these fields (§6.1 step 11).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldName"
          },
          "uniqueItems": true
        },
        "rank": {
          "description": "A ranked field's domain: each value's integer rank (§3.2 joinRanked).",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer"
          }
        },
        "opens": {
          "description": "On a server-written field of a tree-scoped singleton: the values that open the tree to every reader (D-4).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "default": {
          "description": "On a lattice field: the value a reader takes while the register is unset (§2.4). It is on the field's domain; the engine never stores or sends it."
        }
      },
      "allOf": [
        {
          "description": "A bound states its unit (D-9).",
          "if": {
            "required": [
              "min"
            ]
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        },
        {
          "if": {
            "required": [
              "max"
            ]
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ranked"
              }
            }
          },
          "then": {
            "required": [
              "rank"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "serial"
              }
            }
          },
          "then": {
            "required": [
              "serialNext"
            ],
            "properties": {
              "writer": {
                "const": "server"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "max"
            ]
          }
        },
        {
          "if": {
            "required": [
              "parent"
            ]
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "required": [
              "opens"
            ]
          },
          "then": {
            "properties": {
              "writer": {
                "const": "server"
              }
            }
          }
        }
      ]
    },
    "domain": {
      "description": "A value's shape. `nullable` admits null as well.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "nullable": {
              "type": "boolean"
            },
            "enum": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "pattern": {
              "$ref": "#/$defs/regex"
            },
            "unit": {
              "enum": [
                "chars",
                "bytes"
              ]
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          },
          "allOf": [
            {
              "description": "A bound states its unit (D-9).",
              "if": {
                "required": [
                  "min"
                ]
              },
              "then": {
                "required": [
                  "unit"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "max"
                ]
              },
              "then": {
                "required": [
                  "unit"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "nullable": {
              "type": "boolean"
            },
            "integer": {
              "type": "boolean"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "quantum": {
              "description": "The number's step at any depth: an integer, or 1/k for an integer k (0.01, 0.1, 0.5), so that 1/quantum is an integer, which the registry loader checks. Clients round to it half away from zero; the server refuses a value off it (§2.4, §7.1 step 4).",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "boolean",
                "fracKey",
                "stamp",
                "id",
                "json"
              ]
            },
            "nullable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "nullable": {
              "type": "boolean"
            },
            "items": {
              "$ref": "#/$defs/domain"
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "nullable": {
              "type": "boolean"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/fieldName"
              },
              "additionalProperties": {
                "$ref": "#/$defs/domain"
              }
            },
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldName"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "origins",
        "serverInternal",
        "args"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*\\.[a-z][A-Za-z0-9]*$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "origins": {
          "$ref": "#/$defs/origins"
        },
        "serverInternal": {
          "description": "Only the server calls it; a replica's call is refused forbidden (§6.1 step 3).",
          "type": "boolean"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fieldName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argument"
          }
        },
        "predicts": {
          "description": "The types whose records the command's client prediction may carry (§7.1 `predict`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeName"
          },
          "uniqueItems": true
        },
        "beforePull": {
          "description": "A server-internal command that runs before every pull of its scope, in its own admission (§6.7).",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "beforePull": {
                "const": true
              }
            },
            "required": [
              "beforePull"
            ]
          },
          "then": {
            "properties": {
              "serverInternal": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "description": "`time`: device-produced epoch ms, clamped like a time field. `instant`: epoch ms the user chose, refused invalid beyond the skew bound. `ref<t>`: an id of type t, rewritten by write maps and followed by dependent folding (§2.4, §7.7).",
          "type": "string",
          "pattern": "^(json|time|instant|ref<[a-z][A-Za-z0-9]*>)$"
        },
        "optional": {
          "type": "boolean"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        }
      }
    }
  }
}
