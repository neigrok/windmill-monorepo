[
  {
    "name": "empty text has no tokens",
    "input": {
      "text": ""
    },
    "expect": {
      "tokens": []
    }
  },
  {
    "name": "a single space",
    "input": {
      "text": " "
    },
    "expect": {
      "tokens": [
        " "
      ]
    }
  },
  {
    "name": "one word",
    "input": {
      "text": "word"
    },
    "expect": {
      "tokens": [
        "word"
      ]
    }
  },
  {
    "name": "words and a space",
    "input": {
      "text": "a b"
    },
    "expect": {
      "tokens": [
        "a",
        " ",
        "b"
      ]
    }
  },
  {
    "name": "runs of whitespace are one token",
    "input": {
      "text": "  a  \t b  "
    },
    "expect": {
      "tokens": [
        "  ",
        "a",
        "  \t ",
        "b",
        "  "
      ]
    }
  },
  {
    "name": "tab, newline, vertical tab, form feed, carriage return",
    "input": {
      "text": "a\tb\nc\u000bd\fe\rf"
    },
    "expect": {
      "tokens": [
        "a",
        "\t",
        "b",
        "\n",
        "c",
        "\u000b",
        "d",
        "\f",
        "e",
        "\r",
        "f"
      ]
    }
  },
  {
    "name": "no-break space is whitespace",
    "input": {
      "text": "a b"
    },
    "expect": {
      "tokens": [
        "a",
        " ",
        "b"
      ]
    }
  },
  {
    "name": "ogham space, en quad..hair space, narrow no-break space",
    "input": {
      "text": "a b c d e"
    },
    "expect": {
      "tokens": [
        "a",
        " ",
        "b",
        " ",
        "c",
        " ",
        "d",
        " ",
        "e"
      ]
    }
  },
  {
    "name": "line and paragraph separators are whitespace",
    "input": {
      "text": "a b c"
    },
    "expect": {
      "tokens": [
        "a",
        " ",
        "b",
        " ",
        "c"
      ]
    }
  },
  {
    "name": "medium mathematical space and ideographic space",
    "input": {
      "text": "a b　c"
    },
    "expect": {
      "tokens": [
        "a",
        " ",
        "b",
        "　",
        "c"
      ]
    }
  },
  {
    "name": "the byte-order mark is whitespace",
    "input": {
      "text": "a﻿b"
    },
    "expect": {
      "tokens": [
        "a",
        "﻿",
        "b"
      ]
    }
  },
  {
    "name": "zero-width space is not whitespace",
    "input": {
      "text": "a​b"
    },
    "expect": {
      "tokens": [
        "a​b"
      ]
    }
  },
  {
    "name": "next line (U+0085) is not whitespace",
    "input": {
      "text": "ab"
    },
    "expect": {
      "tokens": [
        "ab"
      ]
    }
  },
  {
    "name": "mongolian vowel separator is not whitespace",
    "input": {
      "text": "a᠎b"
    },
    "expect": {
      "tokens": [
        "a᠎b"
      ]
    }
  },
  {
    "name": "punctuation stays in its word",
    "input": {
      "text": "hello, world!"
    },
    "expect": {
      "tokens": [
        "hello,",
        " ",
        "world!"
      ]
    }
  }
]
