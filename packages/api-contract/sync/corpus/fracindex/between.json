[
  {
    "name": "an empty list",
    "input": {
      "a": null,
      "b": null
    },
    "expect": {
      "key": "a0"
    }
  },
  {
    "name": "before the first key",
    "input": {
      "a": null,
      "b": "a0"
    },
    "expect": {
      "key": "Zz"
    }
  },
  {
    "name": "after the first key",
    "input": {
      "a": "a0",
      "b": null
    },
    "expect": {
      "key": "a1"
    }
  },
  {
    "name": "between adjacent integers",
    "input": {
      "a": "a0",
      "b": "a1"
    },
    "expect": {
      "key": "a0V"
    }
  },
  {
    "name": "between a key and its next integer",
    "input": {
      "a": "a0V",
      "b": "a1"
    },
    "expect": {
      "key": "a0l"
    }
  },
  {
    "name": "between an integer and a fraction",
    "input": {
      "a": "a0",
      "b": "a0V"
    },
    "expect": {
      "key": "a0G"
    }
  },
  {
