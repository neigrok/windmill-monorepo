      "b": "a0"
    },
    "expect": {
      "key": "ZzV"
    }
  },
  {
    "name": "after the last one-digit positive integer rolls to two digits",
    "input": {
      "a": "az",
      "b": null
    },
    "expect": {
      "key": "b00"
    }
  },
  {
    "name": "before Zz",
    "input": {
      "a": null,
      "b": "Zz"
    },
    "expect": {
      "key": "Zy"
    }
  },
  {
    "name": "before Z0 rolls the head down",
    "input": {
      "a": null,
      "b": "Z0"
    },
    "expect": {
      "key": "Yzz"
    }
  },
  {
    "name": "after b00",
    "input": {
      "a": "b00",
      "b": null
    },
    "expect": {
      "key": "b01"
    }
  },
  {
    "name": "different integer parts take the next integer",
    "input": {
      "a": "a0",
      "b": "a9"
    },
    "expect": {
      "key": "a1"
    }
  },
  {
    "name": "equal keys are refused",
    "input": {
      "a": "a1",
      "b": "a1"
    },
    "expect": {
      "error": true
    }
  },
  {
    "name": "descending keys are refused",
    "input": {
      "a": "a2",
      "b": "a1"
    },
    "expect": {
      "error": true
    }
  },
  {
    "name": "a trailing zero is not a key",
    "input": {
      "a": "a10",
      "b": null
    },
    "expect": {
      "error": true
    }
  },
  {
    "name": "a head outside [A-Za-z] is not a key",
    "input": {
      "a": "!0",
      "b": null
    },
    "expect": {
      "error": true
    }
  },
  {
    "name": "a character outside base 62 is not a key",
    "input": {
      "a": "a0!",
      "b": null
    },
    "expect": {
      "error": true
    }
  },
  {
    "name": "a key shorter than its head demands is refused",
    "input": {
      "a": "a",
      "b": null
    },
    "expect": {
      "error": true
    }
  },
  {
    "name": "the internal floor is not a key",
    "input": {
      "a": "A00000000000000000000000000",
      "b": null
    },
    "expect": {
      "error": true
    }
  },
