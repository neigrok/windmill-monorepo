[
  {
    "name": "no credential is anonymous",
    "input": {
      "headers": [
        [
          "Accept",
          "application/json"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null
      }
    }
  },
  {
    "name": "cookies other than the session cookie are no credential",
    "input": {
      "headers": [
        [
          "Cookie",
          "theme=dark; lang=en"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null
      }
    }
  },
  {
    "name": "a session cookie that resolves serves its account",
    "input": {
      "headers": [
        [
          "Cookie",
          "theme=dark; wm_session=s-ann"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": "A"
      }
    }
  },
  {
    "name": "a Bearer Authorization header that resolves serves its account",
    "input": {
      "headers": [
        [
          "Authorization",
          "Bearer s-bob"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": "B"
      }
    }
  },
  {
    "name": "header names compare case-insensitively",
    "input": {
      "headers": [
        [
          "authorization",
          "Bearer s-bob"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": "B"
      }
    }
  },
  {
    "name": "header names fold ASCII case only: a Kelvin sign (U+212A) for the K of Cookie names another header",
    "input": {
      "headers": [
        [
          "CooKie",
          "wm_session=s-ann"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null
      }
    }
  },
  {
    "name": "a session cookie no live session holds does not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session=s-gone"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "a bare session cookie with no = is a credential that does not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "theme=dark; wm_session"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "an empty session cookie is a credential that does not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session="
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "a session cookie's token is its value verbatim: a quoted token does not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session=\"s-ann\""
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "space and tab around a session cookie's name and value are trimmed (RFC 6265)",
    "input": {
      "headers": [
        [
          "Cookie",
          "theme=dark;\t wm_session = \ts-ann\t "
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": "A"
      }
    }
  },
  {
    "name": "only space and tab are trimmed: a no-break space around the value stays, so the token does not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session= s-ann"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "a session cookie's token is its value verbatim: an escaped token does not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session=s%2Dann"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "two session cookies in one header do not resolve, even when both name the account",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session=s-ann; wm_session=s-ann"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "two session cookies in two Cookie headers do not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session=s-ann"
        ],
        [
          "Cookie",
          "wm_session=s-bob"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "two Authorization headers do not resolve, even when both name the account",
    "input": {
      "headers": [
        [
          "Authorization",
          "Bearer s-ann"
        ],
        [
          "Authorization",
          "Bearer s-ann-phone"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "an Authorization header of another shape does not resolve",
    "input": {
      "headers": [
        [
          "Authorization",
          "Basic czphbm4="
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "a Bearer header without a token does not resolve",
    "input": {
      "headers": [
        [
          "Authorization",
          "Bearer"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "a cookie and a header naming one account serve it",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session=s-ann"
        ],
        [
          "Authorization",
          "Bearer s-ann-phone"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": "A"
      }
    }
  },
  {
    "name": "a cookie and a header naming different accounts do not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session=s-ann"
        ],
        [
          "Authorization",
          "Bearer s-bob"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  },
  {
    "name": "a malformed cookie beside a header that resolves does not resolve",
    "input": {
      "headers": [
        [
          "Cookie",
          "wm_session"
        ],
        [
          "Authorization",
          "Bearer s-ann"
        ]
      ],
      "sessions": {
        "s-ann": "A",
        "s-ann-phone": "A",
        "s-bob": "B"
      }
    },
    "expect": {
      "principal": {
        "account": null,
        "credential": "unresolved"
      }
    }
  }
]
