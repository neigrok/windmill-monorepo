{
  "$schema": "./registry.schema.json",
  "registry": "gym",
  "version": 3,
  "minVersion": 3,
  "products": {
    "gym": {
      "surfaces": ["web", "ios", "android"],
      "device": {
        "movementOrder": {
          "keyPattern": "^movementOrder:[A-Za-z0-9_-]{8,64}$",
          "value": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } }
        },
        "movement": { "keyPattern": "^movement:[A-Za-z0-9_-]{8,64}$", "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } },
        "offer": { "keyPattern": "^offer:[A-Za-z0-9_-]{8,64}$", "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" } },
        "rack": { "keyPattern": "^rack:[A-Za-z0-9_-]{8,64}$", "value": { "type": "json" } }
      },
      "codes": ["payload-conflict", "session-finished", "session-open", "session-overlap", "unknown-exercise", "bad-instant", "proposal-settled", "proposal-superseded"]
    }
  },
  "types": [
    {
      "type": "routine",
      "scope": "product:gym",
      "identity": "minted",
      "idSpace": "global",
      "idPattern": "^[A-Za-z0-9_-]{8,64}$",
      "mint": { "prefix": "", "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", "length": 16 },
      "seeded": { "seedMax": 58, "ordinalMax": 99999 },
      "life": true,
      "revivable": false,
      "deadRows": "spent",
      "origins": ["replica", "server"],
      "primary": true,
      "fields": {
        "name": { "kind": "lww", "writer": "client", "unit": "bytes", "min": 1, "max": 240, "domain": { "type": "string" } },
        "position": { "kind": "lww", "writer": "client", "domain": { "type": "number", "integer": true, "min": 0, "max": 2147483647 }, "default": 0 },
        "entries": {
          "kind": "lww",
          "writer": "client",
          "domain": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "exerciseId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "restSeconds": { "type": "number", "integer": true, "min": 15, "max": 900 },
                "sets": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "properties": {
                      "reps": { "type": "number", "integer": true, "min": 1, "max": 100 },
                      "weightKg": { "type": "number", "min": -500, "max": 500, "quantum": 0.01 }
                    }
                  }
                }
              },
              "required": ["exerciseId"]
            }
          }
        },
        "createdDoor": { "kind": "const", "writer": "server", "domain": { "type": "string", "enum": ["mcp", "ask"] } }
      }
    },
    {
      "type": "exercise",
      "scope": "product:gym",
      "identity": "minted",
      "idSpace": "global",
      "idPattern": "^[A-Za-z0-9_-]{1,64}$",
      "mint": { "prefix": "", "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", "length": 16 },
      "seeded": { "seedMax": 58, "ordinalMax": 99999 },
      "life": true,
      "revivable": false,
      "deadRows": "spent",
      "origins": ["replica", "server"],
      "primary": true,
      "fields": {
        "name": { "kind": "lww", "writer": "client", "unit": "bytes", "min": 1, "max": 240, "domain": { "type": "string" } },
        "pattern": {
          "kind": "const",
          "writer": "client",
          "domain": { "type": "string", "enum": ["squat", "hinge", "press", "pull", "carry", "core", "isolation"] }
        },
        "equipment": {
          "kind": "const",
          "writer": "client",
          "domain": { "type": "string", "enum": ["barbell", "dumbbell", "machine", "cable", "bodyweight", "kettlebell"] }
        },
        "stepKg": { "kind": "const", "writer": "client", "domain": { "type": "number", "min": 0.01, "max": 99.99, "quantum": 0.01 } },
        "aliases": {
          "kind": "lww",
          "writer": "server",
          "domain": { "type": "array", "maxItems": 5, "items": { "type": "string", "unit": "bytes", "min": 1, "max": 240 } }
        }
      }
    },
    {
      "type": "exerciseName",
      "scope": "product:gym",
      "identity": "keyed",
      "key": { "ref": "exercise" },
      "life": false,
      "origins": ["replica", "server"],
      "fields": {
        "name": { "kind": "lww", "writer": "client", "unit": "bytes", "min": 1, "max": 240, "domain": { "type": "string" } },
        "aliases": {
          "kind": "lww",
          "writer": "server",
          "domain": { "type": "array", "maxItems": 5, "items": { "type": "string", "unit": "bytes", "min": 1, "max": 240 } }
        }
      }
    },
    {
      "type": "session",
      "scope": "product:gym",
      "identity": "minted",
      "idSpace": "global",
      "idPattern": "^[A-Za-z0-9_-]{8,64}$",
      "mint": { "prefix": "", "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", "length": 16 },
      "seeded": { "seedMax": 58, "ordinalMax": 99999 },
      "life": true,
      "revivable": false,
      "deadRows": "spent",
      "origins": ["replica", "server"],
      "primary": true,
      "fields": {
        "routineId": { "kind": "lww", "writer": "server", "ref": "routine", "domain": { "type": "id", "nullable": true } },
        "historyRoutineId": { "kind": "const", "writer": "server", "domain": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$", "nullable": true } },
        "plan": { "kind": "const", "writer": "server", "domain": { "type": "json", "nullable": true } },
        "startedAt": { "kind": "lww", "writer": "server", "domain": { "type": "number", "integer": true, "min": 0 } },
        "finishedAt": { "kind": "lww", "writer": "server", "domain": { "type": "number", "integer": true, "min": 0 } },
        "closedBy": { "kind": "lww", "writer": "server", "domain": { "type": "string", "enum": ["finish", "stale"] } },
        "displayName": { "kind": "lww", "writer": "server", "unit": "bytes", "max": 240, "domain": { "type": "string", "nullable": true } }
      }
    },
    {
      "type": "set",
      "scope": "product:gym",
      "identity": "minted",
      "idSpace": "global",
      "idPattern": "^[A-Za-z0-9_-]{8,64}$",
      "mint": { "prefix": "", "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", "length": 16 },
      "seeded": { "seedMax": 58, "ordinalMax": 99999 },
      "life": true,
      "revivable": false,
      "deadRows": "spent",
      "origins": ["replica", "server"],
      "primary": true,
      "fields": {
        "sessionId": { "kind": "const", "writer": "client", "ref": "session", "parent": true },
        "exerciseId": { "kind": "const", "writer": "client", "ref": "exercise" },
        "setNumber": { "kind": "serial", "writer": "server", "serialNext": ["sessionId", "exerciseId"] },
        "weightKg": { "kind": "lww", "writer": "client", "domain": { "type": "number", "min": -500, "max": 500, "quantum": 0.01 } },
        "reps": { "kind": "lww", "writer": "client", "domain": { "type": "number", "integer": true, "min": 1, "max": 500 } },
        "kind": { "kind": "lww", "writer": "client", "domain": { "type": "string", "enum": ["warmup", "working", "drop", "failure"] } },
        "rpe": { "kind": "lww", "writer": "client", "domain": { "type": "number", "min": 1, "max": 10, "nullable": true, "quantum": 0.1 } },
        "note": { "kind": "lww", "writer": "client", "unit": "bytes", "max": 4000, "domain": { "type": "string" } },
        "completedAt": { "kind": "lww", "writer": "client", "domain": { "type": "number", "integer": true, "min": 0 } }
      }
    },
    {
      "type": "note",
      "scope": "product:gym",
      "identity": "minted",
      "idSpace": "global",
      "idPattern": "^[A-Za-z0-9_-]{8,64}$",
      "mint": { "prefix": "", "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", "length": 16 },
      "seeded": { "seedMax": 58, "ordinalMax": 99999 },
      "life": true,
      "revivable": false,
      "deadRows": "spent",
      "origins": ["replica", "server"],
      "cap": 10,
      "primary": true,
      "fields": {
        "title": { "kind": "lww", "writer": "client", "unit": "chars", "min": 1, "max": 60, "domain": { "type": "string" } },
        "body": { "kind": "lww", "writer": "client", "unit": "bytes", "max": 500, "domain": { "type": "string" } },
        "ord": { "kind": "lww", "writer": "client", "domain": { "type": "fracKey" } }
      }
    },
    {
      "type": "weighin",
      "scope": "product:gym",
      "identity": "keyed",
      "idPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "life": true,
      "wholePut": true,
      "deadRows": "spent",
      "origins": ["replica", "server"],
      "primary": true,
      "fields": {
        "kg": { "kind": "lww", "writer": "client", "domain": { "type": "number", "min": 20, "max": 400, "quantum": 0.01 } },
        "recordedAt": { "kind": "lww", "writer": "client", "domain": { "type": "number", "integer": true, "min": 0 } }
      }
    },
    {
      "type": "prefs",
      "scope": "product:gym",
      "identity": "singleton",
      "singletonId": "prefs",
      "idPattern": "^prefs$",
      "life": false,
      "origins": ["replica", "server"],
      "fields": {
        "units": { "kind": "lww", "writer": "client", "domain": { "type": "string", "enum": ["kg", "lb"] }, "default": "kg" },
        "restSeconds": { "kind": "lww", "writer": "client", "domain": { "type": "number", "integer": true, "min": 15, "max": 900, "nullable": true }, "default": null },
        "restSound": { "kind": "lww", "writer": "client", "domain": { "type": "boolean" }, "default": true },
        "confirmHaptic": { "kind": "lww", "writer": "client", "domain": { "type": "boolean" }, "default": true },
        "confirmSound": { "kind": "lww", "writer": "client", "domain": { "type": "boolean" }, "default": false }
      }
    },
    {
      "type": "proposal",
      "scope": "product:gym",
      "identity": "minted",
      "idSpace": "global",
      "idPattern": "^[A-Za-z0-9_-]{8,64}$",
      "mint": { "prefix": "", "alphabet": "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", "length": 16 },
      "seeded": { "seedMax": 58, "ordinalMax": 99999 },
      "life": true,
      "revivable": false,
      "deadRows": "spent",
      "origins": ["replica", "server"],
      "fields": {
        "routineId": { "kind": "const", "writer": "client", "ref": "routine" },
        "intent": { "kind": "const", "writer": "client", "domain": { "type": "string", "enum": ["revise", "remove"] } },
        "proposedName": { "kind": "const", "writer": "client", "unit": "bytes", "max": 240, "domain": { "type": "string" } },
        "summary": { "kind": "const", "writer": "client", "unit": "bytes", "max": 400, "domain": { "type": "string" } },
        "changes": {
          "kind": "const",
          "writer": "client",
          "domain": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["kept", "added", "removed", "retargeted"] },
                "exerciseId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "before": {
                  "type": "object",
                  "properties": {
                    "sets": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "object",
                        "properties": {
                          "reps": { "type": "number", "integer": true, "min": 1, "max": 100 },
                          "weightKg": { "type": "number", "min": -500, "max": 500, "quantum": 0.01 }
                        }
                      }
                    },
                    "restSeconds": { "type": "number", "integer": true, "min": 15, "max": 900 }
                  }
                },
                "after": {
                  "type": "object",
                  "properties": {
                    "sets": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "object",
                        "properties": {
                          "reps": { "type": "number", "integer": true, "min": 1, "max": 100 },
                          "weightKg": { "type": "number", "min": -500, "max": 500, "quantum": 0.01 }
                        }
                      }
                    },
                    "restSeconds": { "type": "number", "integer": true, "min": 15, "max": 900 }
                  }
                }
              },
              "required": ["kind", "exerciseId"]
            }
          }
        },
        "door": { "kind": "const", "writer": "client", "domain": { "type": "string", "enum": ["ask", "mcp"] } },
        "connection": { "kind": "const", "writer": "client", "unit": "bytes", "max": 128, "domain": { "type": "string" } },
        "agent": { "kind": "const", "writer": "client", "unit": "chars", "max": 64, "domain": { "type": "string" } },
        "threadId": { "kind": "lww", "writer": "server", "domain": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$", "nullable": true } },
        "state": {
          "kind": "ranked",
          "writer": "server",
          "rank": { "pending": 0, "applied": 1, "dismissed": 1, "superseded": 1 },
          "default": "pending"
        },
        "supersededBy": { "kind": "lww", "writer": "server", "domain": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" } },
        "settledAt": { "kind": "lww", "writer": "server", "domain": { "type": "number", "integer": true, "min": 0 } }
      }
    }
  ],
  "commands": [
    {
      "name": "gym.start",
      "scope": "product:gym",
      "origins": ["replica", "server"],
      "serverInternal": false,
      "args": {
        "id": { "type": "ref<session>" },
        "routineId": { "type": "ref<routine>", "optional": true },
        "startedAt": { "type": "time" },
        "joinOpenSession": { "type": "json", "domain": { "type": "boolean" } }
      },
      "predicts": ["session"]
    },
    {
      "name": "gym.importSession",
      "scope": "product:gym",
      "origins": ["replica", "server"],
      "serverInternal": false,
      "args": {
        "id": { "type": "ref<session>" },
        "routineId": { "type": "ref<routine>", "optional": true },
        "startedAt": { "type": "instant" },
        "finishedAt": { "type": "instant" },
        "sets": {
          "type": "json",
          "domain": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
                "exerciseId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "weightKg": { "type": "number", "min": -500, "max": 500, "quantum": 0.01 },
                "reps": { "type": "number", "integer": true, "min": 1, "max": 500 },
                "kind": { "type": "string", "enum": ["warmup", "working", "drop", "failure"] },
                "rpe": { "type": "number", "min": 1, "max": 10, "nullable": true, "quantum": 0.1 },
                "note": { "type": "string", "unit": "bytes", "max": 4000 },
                "completedAt": { "type": "number", "integer": true, "min": 0 }
              },
              "required": ["id", "exerciseId", "weightKg", "reps", "completedAt"]
            }
          }
        }
      },
      "predicts": ["session", "set"]
    },
    {
      "name": "gym.correctSession",
      "scope": "product:gym",
      "origins": ["replica", "server"],
      "serverInternal": false,
      "args": {
        "sessionId": { "type": "ref<session>" },
        "requestId": { "type": "json", "domain": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" } },
        "startedAt": { "type": "instant" },
        "finishedAt": { "type": "instant" },
        "routineName": { "type": "json", "domain": { "type": "string", "unit": "bytes", "max": 240, "nullable": true } },
        "sets": {
          "type": "json",
          "domain": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
                "exerciseId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "setNumber": { "type": "number", "integer": true, "min": 1, "max": 2147483647 },
                "weightKg": { "type": "number", "min": -500, "max": 500, "quantum": 0.01 },
                "reps": { "type": "number", "integer": true, "min": 1, "max": 500 },
                "rpe": { "type": "number", "min": 1, "max": 10, "nullable": true, "quantum": 0.1 },
                "note": { "type": "string", "unit": "bytes", "max": 4000 },
                "completedAt": { "type": "number", "integer": true, "min": 0 }
              },
              "required": ["id", "exerciseId", "setNumber", "weightKg", "reps", "completedAt"]
            }
          }
        }
      },
      "predicts": ["session", "set"]
    },
    {
      "name": "gym.finish",
      "scope": "product:gym",
      "origins": ["replica", "server"],
      "serverInternal": false,
      "args": {
        "sessionId": { "type": "ref<session>" },
        "finishedAt": { "type": "time" }
      },
      "predicts": ["session"]
    },
    {
      "name": "gym.applyProposal",
      "scope": "product:gym",
      "origins": ["replica", "server"],
      "serverInternal": false,
      "args": {
        "proposalId": { "type": "ref<proposal>" }
      },
      "predicts": ["proposal", "routine"]
    },
    {
      "name": "gym.dismissProposal",
      "scope": "product:gym",
      "origins": ["replica", "server"],
      "serverInternal": false,
      "args": {
        "proposalId": { "type": "ref<proposal>" }
      },
      "predicts": ["proposal"]
    },
    {
      "name": "gym.closeStale",
      "scope": "product:gym",
      "origins": ["server"],
      "serverInternal": true,
      "beforePull": true,
      "args": {}
    }
  ]
}
