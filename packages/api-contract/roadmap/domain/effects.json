  {
    "name": "A Reset of a marked step returns its Up next followers to Locked, and its Done follower stays Done",
    "input": {
      "operation": "effects",
      "tree": {
        "id": "T",
        "meta": {"title": "Learn to sail"},
        "nodes": [
          {"id": "choose", "label": "Choose a course", "ord": "a0"},
          {"id": "parts", "label": "Name the parts", "ord": "a1"},
          {"id": "rig", "label": "Rig the boat", "ord": "a2"},
          {"id": "read", "label": "Read the wind", "ord": "a3"},
          {"id": "tie", "label": "Tie a bowline", "ord": "a4"},
          {"id": "leave", "label": "Leave the dock", "ord": "a5"}
        ],
        "edges": [
          {"from": "choose", "to": "parts", "present": true}, {"from": "parts", "to": "rig", "present": true},
          {"from": "parts", "to": "read", "present": true}, {"from": "parts", "to": "tie", "present": true},
          {"from": "rig", "to": "leave", "present": true}, {"from": "read", "to": "leave", "present": true}
        ],
        "marks": [
          {"node": "choose", "status": "complete", "outOfOrder": false, "recordedAt": null, "deviceAt": 1000},
          {"node": "parts", "status": "complete", "outOfOrder": false, "recordedAt": null, "deviceAt": 2000},
          {"node": "rig", "status": "complete", "outOfOrder": false, "recordedAt": null, "deviceAt": 3000}
        ]
      },
      "ids": ["parts"]
    },
    "expect": {"kept": "choose", "takesEveryStart": false, "deletable": true, "follow": ["rig", "read", "tie"], "relocks": ["read", "tie"]}
  },
