[
  {
    "name": "A roadmap with one starting step keeps it: a delete of it is refused, and the steps after it are its followers",
    "input": {
      "operation": "effects",
      "tree": {
        "id": "T",
        "meta": {"title": "Learn to sail"},
        "nodes": [
          {"id": "choose", "label": "Choose a course", "ord": "a0"},
          {"id": "parts", "label": "Name the parts", "ord": "a1"},
          {"id": "rig", "label": "Rig the boat", "ord": "a2"}
        ],
        "edges": [{"from": "choose", "to": "parts", "present": true}, {"from": "parts", "to": "rig", "present": true}]
      },
      "ids": ["choose"]
    },
    "expect": {"kept": "choose", "takesEveryStart": true, "deletable": false, "follow": ["parts"], "relocks": []}
  },
