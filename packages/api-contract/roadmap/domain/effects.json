  {
    "name": "A Reset counts only a mark the tree counts: a step that opens a roadmap has its mark set aside and relocks nothing",
    "input": {
      "operation": "effects",
      "tree": {
        "id": "T",
        "meta": {"title": "My year"},
        "nodes": [
          {"id": "plan", "label": "Plan the year", "ord": "a0"},
          {"id": "sail", "label": "Learn to sail", "ord": "a1"},
          {"id": "maya", "label": "Take Maya sailing", "ord": "a2"}
        ],
        "edges": [{"from": "plan", "to": "sail", "present": true}, {"from": "sail", "to": "maya", "present": true}],
        "marks": [
          {"node": "plan", "status": "complete", "outOfOrder": false, "recordedAt": null, "deviceAt": 1000},
          {"node": "sail", "status": "complete", "outOfOrder": false, "recordedAt": null, "deviceAt": 2000}
        ],
        "pointers": [{"node": "sail", "present": true, "opens": "S"}]
      },
      "ids": ["sail"]
    },
    "expect": {"kept": "plan", "takesEveryStart": false, "deletable": true, "follow": ["maya"], "relocks": []}
  },
  {
