{
  "catalog": "roadmap/1",
  "abilities": [
    {
      "name": "get_tree",
      "description": "A page of one roadmap. The first page opens with `tree`: its title, its kinds, its guide and how many steps it has. Then come its steps, each after the steps it follows; a step on a loop, or after one, comes last. A step whose state is unknown waits on a roadmap this device has not finished bringing. An answer goes on at `nextCursor`, and a step too long for one page comes in parts, `part` of `parts`, whose texts and lists join in order.",
      "input": {
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "pattern": "^t_[0-9a-f]{16}$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "id",
                "label",
                "kind",
                "state",
                "prerequisites",
                "unlockCount",
                "summary",
                "description",
                "links",
                "opens"
              ]
            },
            "description": "The fields each step comes with; `id` always does. Left out: id, label, kind, state, prerequisites, unlockCount, summary. `summary` is the description's first 160 characters, with … when it is longer."
          },
          "cursor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,8})\\.[1-9][0-9]{0,8}\\.[0-9a-f]{16}$",
            "description": "The `nextCursor` of the page before; leave it out for the first page. Send every other input as the first page's call did, `fields` among them."
          }
        },
        "required": [
          "treeId"
        ],
        "additionalProperties": false
      },
      "result": {
        "maxBytes": 16384,
