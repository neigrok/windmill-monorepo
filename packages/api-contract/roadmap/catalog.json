                    "rename",
                    "describe",
                    "set_kind",
                    "connect",
                    "disconnect",
                    "merge",
                    "split",
                    "set_progress",
                    "add_kind",
                    "rename_kind",
                    "recolor_kind"
                  ]
                },
                "nodeId": {
                  "type": "string",
                  "description": "A step's id, or the `ref` an earlier change gave a new step."
                },
                "ref": {
                  "type": "string",
                  "pattern": "^new:[a-z0-9][a-z0-9-]{0,31}$",
                  "description": "The name a new step or kind goes by in this proposal: new: and up to 32 lowercase letters, digits and hyphens."
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
