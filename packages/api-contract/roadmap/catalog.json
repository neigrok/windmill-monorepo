                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "additionalProperties": false
                  }
                },
                "kind": {
                  "type": "string",
                  "description": "A kind's id, or the `ref` an earlier add_kind gave a new kind."
                },
                "hue": {
                  "type": "string",
                  "enum": [
                    "terracotta",
                    "olive",
                    "gold",
                    "brick",
                    "sky",
                    "plum"
                  ]
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "A step's id, or the `ref` an earlier change gave a new step."
                  }
                },
                "prerequisiteId": {
                  "type": "string",
                  "description": "The step `nodeId` waits on. A step's id, or the `ref` an earlier change gave a new step."
                },
                "removeId": {
                  "type": "string",
                  "description": "The step a merge folds into `nodeId` and removes. A step's id, or the `ref` an earlier change gave a new step."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "complete",
                    "none"
                  ]
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^new:[a-z0-9][a-z0-9-]{0,31}$"
                      },
                      "label": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "links": {
                        "type": "array",
                        "items": {
                          "type": "object",
