    {
      "name": "propose_roadmap_change",
      "description": "Propose one to 100 changes to one roadmap. Nothing is written until the person reviews the proposal and applies it, and a newer proposal replaces the one waiting on this roadmap. Changes apply in order, and a step field takes a step's id or the `ref` an earlier change gave a new step. Each op takes exactly these fields, required before the semicolon:\nadd_step: ref, label; description, kind (else terracotta), prerequisites, links\nremove_step: nodeId. The steps after it follow its own prerequisites\nrename: nodeId, label\ndescribe: nodeId; description, links, at least one\nset_kind: nodeId, kind\nconnect, disconnect: nodeId, the step that waits; prerequisiteId, the step it waits on\nmerge: nodeId, kept; removeId, folded in and removed; label, description, the kept step's. Links of removeId move to nodeId\nsplit: nodeId, parts, two or more, each ref, label; description, kind, links. Each part follows the old step's prerequisites, precedes what it unlocked and takes its mark and, unless it names one, its kind\nset_progress: nodeId, status\nadd_kind: kind, a new id; label, hue; description\nrename_kind: kind, label\nrecolor_kind: kind, hue. Two kinds may swap hues; no two may end on one\nThe answer names each step the proposal removes, with what it holds.",
      "input": {
        "type": "object",
        "properties": {
          "treeId": {
            "type": "string",
            "pattern": "^t_[0-9a-f]{16}$"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "enum": [
                    "add_step",
                    "remove_step",
                    "rename",
                    "describe",
                    "set_kind",
                    "connect",
                    "disconnect",
                    "merge",
                    "split",
                    "set_progress",
                    "add_kind",
                    "rename_kind",
                    "recolor_kind"
                  ]
                },
                "nodeId": {
                  "type": "string",
                  "description": "A step's id, or the `ref` an earlier change gave a new step."
                },
                "ref": {
                  "type": "string",
                  "pattern": "^new:[a-z0-9][a-z0-9-]{0,31}$",
                  "description": "The name a new step goes by in this proposal: new: and up to 32 lowercase letters, digits and hyphens."
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "additionalProperties": false
                  }
                },
                "kind": {
                  "type": "string",
                  "description": "A kind's id; for add_kind, the new kind's."
                },
                "hue": {
                  "type": "string",
                  "enum": [
                    "terracotta",
                    "olive",
                    "gold",
                    "brick",
                    "sky",
                    "plum"
                  ]
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "A step's id, or the `ref` an earlier change gave a new step."
                  }
                },
                "prerequisiteId": {
                  "type": "string",
                  "description": "The step `nodeId` waits on. A step's id, or the `ref` an earlier change gave a new step."
                },
                "removeId": {
                  "type": "string",
                  "description": "The step a merge folds into `nodeId` and removes. A step's id, or the `ref` an earlier change gave a new step."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "complete",
                    "none"
                  ]
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "pattern": "^new:[a-z0-9][a-z0-9-]{0,31}$"
                      },
                      "label": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "links": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string"
                            },
                            "label": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "url"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "ref",
                      "label"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The steps a split makes, two or more."
                }
              },
              "required": [
                "op"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
