<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may talk cleartext to the local stack; release builds carry no such exception. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/net_security_debug">
        <provider android:name=".DesignCaptureProvider" android:authorities="${applicationId}.design-capture" android:exported="false" />
        <activity android:name=".DesignCaptureActivity" android:exported="true" />
    </application>
</manifest>
