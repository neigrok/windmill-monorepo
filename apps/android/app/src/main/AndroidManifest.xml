<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- THE SESSION SECRET DOES NOT RIDE A BACKUP. A 90-day bearer of somebody's whole account,
         their email, and every gym file under files/ were copied into Google's cloud backup and
         into device-to-device transfer by Android's DEFAULT — and on API 26-30 `adb backup` pulls
         the same bytes off any phone with USB debugging on, no root. A restored secret is a
         signed-in seat on a device the account never approved. `allowBackup` closes cloud backup
         and adb on every release this app runs on; `dataExtractionRules` closes the device
         transfer that Android 12 stopped letting `allowBackup` speak for, and `fullBackupContent`
         says the same thing to the releases below 31. The secret is sealed on disk as well
         (SecretVault) — the transport and the bytes are closed independently on purpose. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="Windmill"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Windmill"
        android:supportsRtl="true">

        <!-- uiMode/locale/fontScale/density ride along deliberately: the gym skin is pinned dark
             and the room holds a live offline queue — an activity recreation mid-flush would put
             two queues on one file, and the outgoing one can clobber what the fresh one wrote. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale|density"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
