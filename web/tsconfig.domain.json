{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/platform/domain-kit",
    "src/products/*/domain",
    "test/platform/domain-kit",
    "test/products/*/domain"
  ]
}
