{
  "name": "windmill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Windmill — roadmap tracker that renders any roadmap as an RPG skill tree. Design-system component library.",
  "scripts": {
    "dev": "vite",
    "test": "node --test --test-timeout=30000 test/",
    "prebuild": "node scripts/fetch-model.mjs",
    "build": "node --test --test-timeout=30000 test/ && vite build && node scripts/build-landing-shells.mjs",
    "preview": "vite preview",
    "test:model": "node scripts/verify-model.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@huggingface/transformers": "3.8.1",
    "lucide-react": "^0.400.0",
    "mediabunny": "^1.51.0",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
